<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Components live in the Web library; include the framework's Blazor browser assets in this host. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Huishoudboek.Web/Huishoudboek.Web.csproj" />
    <ProjectReference Include="../Huishoudboek.Infrastructure/Huishoudboek.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup><Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
