<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized><p>@L["SessionExpired"] <a href="login" data-enhance-nav="false">@L["SignInAgain"]</a></p></NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound><LayoutView Layout="typeof(MainLayout)"><h1>@L["PageNotFound"]</h1><a href="">@L["GoToMonthlyOverview"]</a></LayoutView></NotFound>
</Router>
