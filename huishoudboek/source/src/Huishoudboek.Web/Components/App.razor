@inject NavigationManager Navigation
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="@Navigation.BaseUri" />
    <link rel="icon" type="image/svg+xml" href="_content/Huishoudboek.Web/favicon.svg" />
    <link rel="stylesheet" href="_content/Huishoudboek.Web/site.css" />
    <link rel="stylesheet" href="_content/Huishoudboek.Web/Huishoudboek.Web.bundle.scp.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="components-reconnect-modal" role="alert" aria-live="assertive">
        <h2>Verbinding met de service onderbroken</h2><p>Wacht op herstel. Een onderbroken antwoord kan betekenen dat een wijziging wel is opgeslagen. Controleer vóór opnieuw opslaan.</p>
        <a href="" data-enhance-nav="false">Opnieuw verbinden / aanmelden</a>
    </div>
    <div id="blazor-error-ui" role="alert">Er is een fout opgetreden. Controleer uw gegevens vóór opnieuw opslaan. <a href="" data-enhance-nav="false">Opnieuw laden</a></div>
    <script src="_content/Huishoudboek.Web/site.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
