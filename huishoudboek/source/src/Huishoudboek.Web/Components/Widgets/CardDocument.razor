<!DOCTYPE html>
<html lang="@UiCulture.Language" data-theme="@Model.Theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="@Model.AppBase" target="_blank" />
    <title>@L[Model.TitleKey] · Huishoudboek</title>
    <link rel="stylesheet" href="_content/Huishoudboek.Web/site.css" />
    <link rel="stylesheet" href="_content/Huishoudboek.Web/Huishoudboek.Web.bundle.scp.css" />
    <link rel="stylesheet" href="_content/Huishoudboek.Web/dashboard-cards.css" />
</head>
<body>
    <main class="widget-root" data-huishoudboek-widget="@Model.Widget" data-card-protocol="1">
        @if (Model.Overview.Accounts.Count == 0)
        {
            <section class="card"><h1>@L[Model.TitleKey]</h1><p>@L["DashboardNoAccounts"]</p><a href="instellen" rel="noopener noreferrer">@L["GetStarted"] →</a></section>
        }
        else if (Model.Widget == "month-overview")
        { <DashboardMonth Report="Model.Overview.Month" Year="Model.Year" Month="Model.Month" /> }
        else if (Model.Widget == "spending")
        { <DashboardSpending Report="Model.Overview.Month" Year="Model.Year" Month="Model.Month" OwnerId="Model.OwnerId" /> }
        else if (Model.Widget == "budget-watch")
        { <DashboardBudgetWatch Report="Model.Overview.Month" /> }
        else if (Model.Widget == "upcoming")
        { <DashboardUpcoming Overview="Model.Overview" /> }
        else if (Model.Widget == "data-status")
        { <DashboardDataStatus Overview="Model.Overview" Year="Model.Year" Month="Model.Month" /> }
        else if (Model.Widget == "import-status")
        { <DashboardImportStatus Overview="Model.Overview" /> }
        else if (Model.Widget == "category-trend" && Model.CategoryHistory is { } history)
        { <DashboardCategoryTrend Overview="history" CategoryName="@(Model.CategoryName ?? L["Uncategorized"].Value)" /> }
        else if (Model.Insights is { } insights)
        {
            <FreedomMap Overview="insights.Freedom" LimitedHistory="insights.LimitedHistory" Compact="true" />
        }
        <div class="widget-context">
            @if (Model.Widget == "freedom-map" && Model.Insights is { } analysis)
            { <p>@L["InsightsPeriodNote", Model.Overview.Today.ToString("dd-MM-yyyy"), analysis.CoveredMonths]</p><p>@L["FreedomNotIndependence"]</p> }
            else if (Model.Widget == "category-trend" && Model.CategoryHistory is { } trend)
            { <p>@trend.From.ToString("MMM yyyy", UiCulture.Culture) — @trend.Through.ToString("MMM yyyy", UiCulture.Culture) · @L["CardActualOnly"]</p> }
            else if (Model.Widget is "upcoming" or "import-status")
            { <p>@L[Model.Widget == "upcoming" ? "CardPlanningAt" : "CardStatusAt", Model.Overview.Today.ToString("dd-MM-yyyy")]</p> }
            else if (Model.Widget == "data-status")
            { <p>@L["CardBankStatusAt", Model.Overview.Today.ToString("dd-MM-yyyy")] · @(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy", UiCulture.Culture))</p> }
            else
            { <p>@(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy", UiCulture.Culture)) · @L["CardActualOnly"]</p> }
            <p>@(Model.OwnerName ?? L["AllOwners"].Value) · @L["CardSnapshotAt", DateTime.Now.ToString("dd-MM-yyyy HH:mm", UiCulture.Culture)]</p>
            @if (Model.Overview.Accounts.Count > 0)
            {
                var accounts = Model.Widget is "upcoming" or "import-status" ? Model.Overview.Accounts.Where(a => a.Account.Kind == AccountKind.Current).ToArray() : Model.Overview.Accounts.ToArray();
                var through = accounts.Any(a => a.ImportedThrough == null) ? null : accounts.Min(a => a.ImportedThrough);
                var stale = accounts.Count(a => a.StaleImports);
                <p class="@(stale > 0 ? "widget-warning" : "")">@L["DashboardImportedThrough", through?.ToString("dd-MM-yyyy") ?? L["Unknown"].Value]
                    @if (stale > 0) { <span> · @L["CardStaleAccounts", stale]</span> }
                </p>
            }
            @if (Model.OwnerName != null) { <p>@L["OwnerFilterNote"]</p> }
            <p><a href="@Model.AppLink" rel="noopener noreferrer">@L["CardOpenApp"] ↗</a></p>
        </div>
    </main>
</body>
</html>

@code {
    [Parameter, EditorRequired] public DashboardCardModel Model { get; set; } = null!;
}
