@inherits LayoutComponentBase
@implements IDisposable
@inject WebState State
@inject IJSRuntime JS
@inject WebHostSettings HostSettings
@inject NavigationManager NavigationManager

<a class="skip-link" href="#content">@L["SkipToContent"]</a>
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">huishoudboek<small>@L["Tagline"]</small></div>
        <nav aria-label="@L["MainNavigation"]">
            @foreach (var entry in Navigation)
            {
                <NavLink href="@entry.Path.TrimStart('/')" Match="@(entry.Path == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"><span aria-hidden="true">@entry.Symbol</span>@L[entry.Label]</NavLink>
            }
        </nav>
        <form method="post" action="website/language" data-enhance="false" class="language-switch" aria-label="@L["Language"]" title="@L["LanguageReloadWarning"]">
            <AntiforgeryToken />
            <input type="hidden" name="returnPath" value="@NavigationManager.ToBaseRelativePath(NavigationManager.Uri)" />
            <button type="submit" name="language" value="nl" lang="nl" aria-label="Nederlands" aria-current="@(UiCulture.Language == "nl" ? "true" : null)" disabled="@State.Busy">NL</button>
            <span aria-hidden="true">-</span>
            <button type="submit" name="language" value="en" lang="en" aria-label="English" aria-current="@(UiCulture.Language == "en" ? "true" : null)" disabled="@State.Busy">EN</button>
        </form>
        <p class="sidebar-note">@L["LocalPrivate"]<br />@L["NoBankConnection"]</p>
    </aside>
    <div class="workspace">
        <header class="topbar">
            <div><strong>Huishoudboek · @(HostSettings.HomeAssistant ? "Home Assistant" : "website")</strong><small>@L[State.OwnerId == null ? "HouseholdFilterNote" : "OwnerFilterNote"]</small></div>
            <div class="toolbar">
                <button title="@L["RefreshHint"]" disabled="@State.Busy" @onclick="Reload">@L["Refresh"]</button>
                <button aria-label="@L["PreviousMonth"]" @onclick="() => Shift(-1)">‹</button>
                <label class="compact"><span class="sr-only">@L["Month"]</span><select @bind="State.Month" @bind:after="State.Notify">@for (var m = 1; m <= 12; m++) { <option value="@m">@UiCulture.Culture.DateTimeFormat.GetMonthName(m)</option> }</select></label>
                <label class="compact"><span class="sr-only">@L["Year"]</span><input type="number" min="1900" max="2200" value="@State.Year" @onchange="YearChanged" class="year" /></label>
                <button aria-label="@L["NextMonth"]" @onclick="() => Shift(1)">›</button>
                <label class="compact"><span class="sr-only">@L["Owner"]</span><select @bind="State.OwnerId" @bind:after="State.Notify"><option value="">@L["AllOwners"]</option>@foreach (var owner in State.Data.Owners) { <option value="@owner.Id">@owner.Name</option> }</select></label>
                @if (!HostSettings.HomeAssistant) { <a class="button" href="signout" data-enhance-nav="false">@L["SignOut"]</a> }
            </div>
        </header>
        <main id="content" aria-busy="@State.Busy">
            @if (!string.IsNullOrEmpty(State.Message)) { <div id="message" class="notice @(State.IsError ? "error" : "success")" role="status" aria-live="polite">@State.Message</div> }
            @if (State.Loaded) { <div id="application"><fieldset class="page-fieldset" disabled="@State.Busy">@Body</fieldset></div> }
            else { <h1>@L["LoadingRecords"]</h1><p>@L["LocalConnectionNote"]</p> }
        </main>
        <footer>@L["FooterNote"] <a href="beheer">@L["BackupAdministration"]</a></footer>
    </div>
</div>

@code {
    private static readonly (string Path, string Symbol, string Label)[] Navigation = [
        ("/", "◷", "MonthlyOverview"), ("/jaar", "▥", "AnnualOverview"), ("/transacties", "⇄", "Transactions"),
        ("/categoriseren", "✓", "Categorize"), ("/rekeningen", "▣", "Accounts"), ("/budgetten", "◉", "Budgets"),
        ("/vaste-posten", "↻", "RecurringPayments"), ("/hypotheek", "⌂", "Mortgage"), ("/beheer", "⚙", "AdministrationImport")];
    protected override async Task OnInitializedAsync()
    {
        State.Changed += Changed;
        if (!State.Loaded) await State.RunAsync(State.LoadAsync);
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    private bool ready;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ready && State.Loaded) { ready = true; await JS.InvokeVoidAsync("huishoudboek.markReady"); }
    }
    private async Task Reload() => await State.RunAsync(State.LoadAsync, L["RecordsRefreshed"]);
    private void Shift(int step)
    {
        var date = new DateOnly(State.Year, State.Month, 1).AddMonths(step);
        if (date.Year is < 1900 or > 2200) return;
        State.Year = date.Year; State.Month = date.Month; State.Notify();
    }
    private void YearChanged(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var year) && year is >= 1900 and <= 2200) State.Year = year; State.Notify(); }
    public void Dispose() => State.Changed -= Changed;
}
