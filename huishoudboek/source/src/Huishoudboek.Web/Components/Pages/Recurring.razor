@page "/vaste-posten"
@attribute [Authorize]
@inherits EditPageBase
<PageTitle>@L["RecurringPayments"] · Huishoudboek</PageTitle>
<h1>@L["RecurringIncomeBills"]</h1>
<div class="actions"><button class="primary" @onclick="() => Draft = EditorDraft.Recurring(State)">+ @L["RecurringPayment"]</button></div>
<p class="muted">@L["RecurringPlanningNote"] <a href="#koppelen">@L["MatchBankEntries"]</a> @L["AvoidDuplicateEstimates"]</p>
<section class="card"><div class="table-scroll"><table><thead><tr><th>@L["Name"]</th><th>@L["Account"]</th><th class="money">@L["AmountPerPayment"]</th><th>@L["FrequencyDay"]</th><th>@L["Category"]</th><th>@L["Period"]</th><th>@L["Recognition"]</th><th></th></tr></thead><tbody>
@foreach (var r in State.Data.RecurringPayments.Where(r => State.Scope.Contains(r.AccountId)))
{ <tr><td>@r.Name @if (r.IsMortgage) { <span class="badge">@L["Mortgage"]</span> }</td><td>@State.AccountName(r.AccountId)</td><td class="money">@Money(r.Amount)</td><td>@EditorDraft.Frequency(r.Frequency) @(r.Frequency == PaymentFrequency.Once ? "" : L["PaymentDay", r.DayOfMonth].Value)</td><td>@State.CategoryName(r.CategoryId)</td><td>@r.StartDate.ToString("dd-MM-yyyy") – @(r.EndDate?.ToString("dd-MM-yyyy") ?? L[r.Frequency == PaymentFrequency.Once ? "Once" : "Ongoing"].Value)</td><td>@r.MatchText<small>± @Money(r.MatchTolerance) / @L["Days", r.MatchWindowDays]</small></td><td><div class="actions"><button @onclick="() => Draft = EditorDraft.Recurring(State, r)">@L["Edit"]</button><button @onclick="() => AskDelete(r)">@L["Delete"]</button></div></td></tr> }
</tbody></table></div></section>
<section class="card" id="koppelen"><h2>@L["MatchScheduledPayment"]</h2>
    <p class="muted">@L["RecurringMatchNote"]</p>
    <p class="muted">@L["RecurringBatchExistingNote"]</p>
    <div class="filters"><label>@L["Search"]<input type="search" @bind="search" @bind:event="oninput" @bind:after="ResetPage" /></label></div>
    @{ var candidates = RecurringSchedule.Candidates(State.Data, State.Today).Where(c => State.Scope.Contains(c.Payment.AccountId) && InSearch(c.Payment.Name, c.Transaction)).ToList(); page = Math.Min(page, Math.Max(0, (candidates.Count - 1) / 20)); }
    <h3>@L["PossibleMatches"] (@candidates.Count)</h3>
    @foreach (var candidate in candidates.Skip(page * 20).Take(20))
    {
        <div class="card" @key="(candidate.Payment.Id, candidate.Transaction.Id, candidate.DueDate)">
            <strong>@candidate.Payment.Name · @L["Planned"] @candidate.DueDate.ToString("dd-MM-yyyy") · @Money(candidate.Payment.Amount)</strong>
            <p>@EntryLabel(candidate.Transaction)<br />@L["EstimateDifference", Money(candidate.Difference)]</p>
            @if (candidates.Count(c => c.Transaction.Id == candidate.Transaction.Id || c.Payment.Id == candidate.Payment.Id && c.DueDate == candidate.DueDate) > 1)
            { <p class="notice warning">@L["MultipleRecurringCandidates"]</p> }
            <button class="primary" @onclick="() => ConfirmLink(candidate.Transaction, candidate.Payment, candidate.DueDate)">@L["ConfirmMatch"]…</button>
        </div>
    }
    @if (candidates.Count == 0) { <p class="muted">@L["NoRecurringSuggestions"]</p> }
    <Pager Count="candidates.Count" Size="20" @bind-Page="page" />
    <details><summary>@L["ManualRecurringMatch"]</summary>
        <div class="fields">
            <label>@L["BankEntry"]<select @bind="transactionId" @bind:after="ResetPayment"><option value="">@L["ChooseBankEntry"]</option>@foreach (var t in AvailableTransactions.Where(t => InSearch("", t)).OrderByDescending(t => t.Date).Take(100)) { <option value="@t.Id">@EntryLabel(t)</option> }</select></label>
            <label>@L["RecurringPayment"]<select @bind="paymentId" @bind:after="ResetDue"><option value="">@L["ChooseRecurringPayment"]</option>@foreach (var r in AvailablePayments) { <option value="@r.Id">@r.Name · @Money(r.Amount)</option> }</select></label>
            <label>@L["PlannedPaymentDate"]<input type="date" @bind="dueDate" /></label>
        </div>
        <p class="muted">@L["ManualRecurringNote"]</p>
        @if (SelectedTransaction is { } transaction && SelectedPayment is { } payment && dueDate is { } due)
        { <button class="primary" @onclick="() => ConfirmLink(transaction, payment, due)">@L["ConfirmMatch"]…</button> }
    </details>
    <details><summary>@L["ViewUnmatchBankEntries"]</summary>
        @{ var linked = State.Data.Transactions.Where(t => t.RecurringPaymentId != null && State.Scope.Contains(t.AccountId) && InSearch(State.Data.RecurringPayments.Single(r => r.Id == t.RecurringPaymentId).Name, t)).OrderByDescending(t => t.Date).ToList(); }
        <div class="table-scroll"><table><thead><tr><th>@L["PlannedPayment"]</th><th>@L["BankEntry"]</th><th class="money">@L["Actual"]</th><th></th></tr></thead><tbody>
        @foreach (var t in linked.Take(100))
        { var r = State.Data.RecurringPayments.Single(r => r.Id == t.RecurringPaymentId);
            <tr><td>@r.Name · @RecurringSchedule.LinkedDate(r, t).ToString("dd-MM-yyyy")</td><td>@t.Date.ToString("dd-MM-yyyy") · @State.AccountName(t.AccountId) · @t.Description</td><td class="money">@Money(t.Amount)</td><td><button @onclick="() => AskUnlink(t)">@L["Unmatch"]…</button></td></tr>
        }
        </tbody></table></div><p class="muted">@L["VisibleMatchesNote", linked.Count]</p>
    </details>
</section>
<EditDialogs Page="this" />
@code {
    private string search = "", lastRevision = "";
    private Guid? transactionId, paymentId;
    private DateOnly? dueDate;
    private int page;
    private void ResetPage() => page = 0;
    private void ResetPayment() { paymentId = null; dueDate = null; }
    private void ResetDue()
    {
        dueDate = SelectedPayment is { } r && SelectedTransaction is { } t
            ? RecurringSchedule.Occurrences(r, t.Date.AddYears(-1), t.Date.AddYears(1)).OrderBy(d => Math.Abs(d.DayNumber - t.Date.DayNumber)).Select(d => (DateOnly?)d).FirstOrDefault()
            : null;
    }
    protected override void OnStateChanged()
    { if (lastRevision != State.Revision || SelectedTransaction != null && !State.Scope.Contains(SelectedTransaction.AccountId)) { lastRevision = State.Revision; transactionId = null; ResetPayment(); } }
    private bool InSearch(string name, Transaction t) => string.IsNullOrWhiteSpace(search) || $"{name} {State.AccountName(t.AccountId)} {t.Description} {t.UserDescription}".Contains(search, StringComparison.OrdinalIgnoreCase);
    private IEnumerable<Transaction> AvailableTransactions
    {
        get { var transfers = TransferMatching.ConfirmedTransactionIds(State.Data); return State.Data.Transactions.Where(t => t.Date <= State.Today && t.Kind != TransactionKind.Transfer && t.RecurringPaymentId == null && State.Scope.Contains(t.AccountId) && !transfers.Contains(t.Id)); }
    }
    private Transaction? SelectedTransaction => AvailableTransactions.FirstOrDefault(t => t.Id == transactionId);
    private IEnumerable<RecurringPayment> AvailablePayments => SelectedTransaction is { } t ? State.Data.RecurringPayments.Where(r => r.AccountId == t.AccountId && Math.Sign(r.Amount) == Math.Sign(t.Amount)) : [];
    private RecurringPayment? SelectedPayment => AvailablePayments.FirstOrDefault(r => r.Id == paymentId);
    private string EntryLabel(Transaction t) => $"{t.Date:dd-MM-yyyy} · {State.AccountName(t.AccountId)} · {Money(t.Amount)} · {t.Description}";
    private void ConfirmLink(Transaction t, RecurringPayment r, DateOnly due) => Ask(L["LinkPlannedPayment"],
        L["LinkPlannedPaymentQuestion", r.Name, due.ToString("dd-MM-yyyy"), Money(r.Amount), EntryLabel(t)],
        d => RecurringSchedule.Link(d, t.Id, r.Id, due), L["ConfirmMatch"]);
    private void AskUnlink(Transaction t) => Ask(L["RemoveRecurringMatch"], L["RemoveRecurringMatchQuestion"], d => RecurringSchedule.Unlink(d, t.Id), L["Unmatch"]);
    private void AskDelete(RecurringPayment item) => Ask(L["DeleteRecurring"], L["DeleteRecurringQuestion"], d => HouseholdEdits.DeleteRecurring(d, item.Id), L["Delete"]);
}
