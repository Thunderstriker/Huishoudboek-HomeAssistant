@page "/categoriseren"
@attribute [Authorize]
@inherits EditPageBase
<PageTitle>@L["Categorize"] · Huishoudboek</PageTitle>
<h1>@L["Categorize"] · @L["AllDates"]</h1>
<p class="muted">@L["CategoryPurposeHelp"] <a href="budgetten">@L["BudgetsCategories"]</a></p>
<div class="actions">
    <button class="@(mode == "groups" ? "primary" : "")" @onclick='() => SetMode("groups")'>@L["ByCategory"]</button>
    <button class="@(mode == "inbox" ? "primary" : "")" @onclick='() => SetMode("inbox")'>@L["Uncategorized"]</button>
    <button class="@(mode == "walk" ? "primary" : "")" @onclick="StartWalk">@L["StepByStep"]</button>
    <button @onclick="LatestImport">@L["LatestImport"]</button><button @onclick="ClearFilters">@L["ClearFilters"]</button>
</div>
<div class="filters"><label>@L["Account"]<select @bind="accountId" @bind:after="FilterChanged"><option value="">@L["AllAccounts"]</option>@foreach (var a in State.Data.Accounts.Where(a => State.Scope.Contains(a.Id))) { <option value="@a.Id">@a.Name</option> }</select></label>
<label>@L["Import"]<select @bind="batchId" @bind:after="FilterChanged"><option value="">@L["AllImports"]</option>@foreach (var batch in State.Data.ImportBatches.Where(b => !b.Undone).OrderByDescending(b => b.ImportedAt)) { <option value="@batch.Id">@batch.FileName · @batch.ImportedAt.ToString("dd-MM-yyyy HH:mm")</option> }</select></label>
<label>@L["SearchDescription"]<input type="search" @bind="search" @bind:event="oninput" @bind:after="FilterChanged" /></label>
<label class="check"><input type="checkbox" @bind="includeTransfers" @bind:after="FilterChanged" />@L["IncludeInternalTransfers"]</label></div>
@{ var rows = VisibleRows.ToList(); page = Math.Min(page, Math.Max(0, (rows.Count - 1) / 100)); var totals = Categorization.ReviewTotals(State.Data, rows); }
<div class="category-layout">
    @if (mode == "groups")
    {
        <aside class="card category-list" aria-label="@L["CategoryGroups"]">
            @foreach (var group in Groups)
            { <button class="@(group.Id == groupCategory ? "active" : "") @(group.Count == 0 ? "muted" : "")" @onclick="() => SelectGroup(group.Id)"><span>@group.Name</span><span class="badge">@group.Count</span></button> }
        </aside>
    }
    <section class="card" style="@(mode != "groups" ? "grid-column:1/-1" : null)">
        <div class="page-heading"><h2>@(mode == "walk" ? L["StepByStep"].Value : mode == "inbox" ? L["Uncategorized"].Value : State.CategoryName(groupCategory))</h2>
        @if (mode == "groups" && groupCategory is { } categoryId && State.Data.Categories.FirstOrDefault(c => c.Id == categoryId) is { } category)
        { <div class="actions"><button @onclick="() => Draft = EditorDraft.Category(State, category)">@L["CategorySettings"]</button><button @onclick="() => DeleteCategory(category)">@L["DeleteCategory"]</button></div> }
        </div>
        @if (mode != "walk") { <p class="muted">@L["ReviewTotalsNote", rows.Count, Money(totals.Income), Money(totals.Outflow)]</p> }
        @if (mode == "walk")
        {
            @if (Current is { } current)
            {
                <h3>@current.Date.ToString("dd-MM-yyyy") · @State.AccountName(current.AccountId) · @Money(current.Amount)</h3><p class="description">@current.Description</p>
                @if (current.Date > State.Today) { <p class="badge">@L["PlannedFuturePayment"]</p> }
                <p class="muted">@L["WalkRemainingNote", WalkRows.Count()]</p>
            }
            else { <p class="empty">@L["WalkCompleteNote"]</p><button @onclick="StartWalk">@L["StartNewRound"]</button> }
        }
        else
        {
            <div class="table-scroll"><table id="category-transactions"><thead><tr><th>@L["Select"]</th><th>@L["Date"]</th><th>@L["Account"]</th><th>@L["BankOwnDescription"]</th><th class="money">@L["Amount"]</th><th>@L["CategoryType"]</th></tr></thead><tbody>
            @foreach (var t in rows.Skip(page * 100).Take(100))
            {
                <tr @key="t.Id">
                    <td><input type="checkbox" aria-label="@L["SelectPayment"]" checked="@selected.Contains(t.Id)" disabled="@State.Data.TransactionAllocations.Any(a => a.TransactionId == t.Id)" @onchange="e => Select(t, (bool)e.Value!)" /></td>
                    <td>@t.Date.ToString("dd-MM-yyyy") @if (t.Date > State.Today) { <span class="badge">@L["Planned"]</span> }</td>
                    <td>@State.AccountName(t.AccountId) @if (t.Kind == TransactionKind.Transfer) { <span>→ @State.AccountName(t.CounterAccountId)</span> }</td>
                    <td class="description">@if (t.UserDescription.Length > 0) { <strong>@t.UserDescription</strong><small>@t.Description</small> } else { @t.Description }</td>
                    <td class="money">@Money(t.Amount)</td>
                    <td><TransactionAllocationSummary Transaction="t" /> @if (State.Data.TransactionAllocations.Any(a => a.TransactionId == t.Id)) { <a href="transacties">@L["TransactionHandling"]</a> } @if (TransferMatching.IsInternal(State.Data, t)) { <span class="badge">@L[t.Kind == TransactionKind.Transfer ? "InternalTransfer" : "LinkedTransfer"]</span> }</td>
                </tr>
            }
            </tbody></table></div>
            @if (rows.Count == 0) { <p class="empty">@L["NoGroupPayments"]</p> }
            <Pager Count="rows.Count" @bind-Page="page" />
        }
        @if (mode != "walk" || Current != null)
        {
            <form @onsubmit="Assign" @onsubmit:preventDefault>
                <div class="fields"><label>@L["Category"]<select id="assignCategory" @bind="assignCategory"><option value="">@L["Uncategorized"]</option>@foreach (var c in State.Data.Categories) { <option value="@c.Id">@EditorDraft.CategoryLabel(c)</option> }</select></label>
                @if (mode == "walk" || selected.Count == 1) { <label>@L["OwnDescriptionOptional"]<input id="ownDescription" @bind="ownDescription" maxlength="2000" /></label> }</div>
                <label class="check"><input id="rememberRule" type="checkbox" @bind="remember" />@L["RememberImports"]</label>
                @if (remember)
                {
                    <label>@L["DescriptionContains"]<input id="rememberText" @bind="rememberText" @bind:event="oninput" maxlength="500" required /></label>
                    var preview = Categorization.Preview(State.Data, rememberText, assignCategory, FilteredRows.Select(t => t.Id).ToHashSet());
                    <p class="muted">@L["RulePreviewCount", preview.Matches.Count, preview.UncategorizedCount] @L[preview.ReusesRule ? "ReusesRule" : "HouseholdRule"]</p>
                    @foreach (var sample in preview.Matches.Take(3)) { <small class="description">@sample.Description · @Money(sample.Amount)</small><br /> }
                    @if (preview.ConflictingExactRule) { <p class="notice error">@L["ConflictingRuleWarning"]</p> }
                    @if (preview.EarlierConflictCount > 0) { <p class="notice warning">@L["OverlappingRulesWarning", preview.EarlierConflictCount]</p> }
                    <label class="check"><input type="checkbox" @bind="applyMatches" />@L["ApplyFilteredMatches"]</label>
                }
                <div class="actions"><button class="primary" type="submit" disabled="@(mode == "walk" ? assignCategory == null : selected.Count == 0)">@(mode == "walk" ? L["SaveNext"].Value : L["SaveCategoryCount", selected.Count].Value)</button>
                    @if (mode == "walk") { <button type="button" @onclick="Skip">@L["Skip"]</button><button type="button" @onclick='() => SetMode("inbox")'>@L["CloseWalk"]</button> }
                </div>
            </form>
        }
    </section>
</div>
<EditDialogs Page="this" />
@code {
    private string mode = "groups", search = "", ownDescription = "", rememberText = "";
    private Guid? accountId, batchId, groupCategory, assignCategory, lastReview, lastOwner;
    private Guid? walkDraftId;
    private string? assignmentRevision;
    private bool includeTransfers, remember, applyMatches;
    private int page;
    private readonly HashSet<Guid> selected = [], skipped = [];
    private IEnumerable<Transaction> FilteredRows
    {
        get
        {
            var linked = TransferMatching.ConfirmedTransactionIds(State.Data);
            var scope = State.Scope;
            return State.Data.Transactions.Where(t => (scope.Contains(t.AccountId) || t.CounterAccountId is { } counter && scope.Contains(counter)) &&
                (accountId == null || t.AccountId == accountId || t.CounterAccountId == accountId) && (batchId == null || t.ImportBatchId == batchId) &&
                (includeTransfers || t.Kind != TransactionKind.Transfer && !linked.Contains(t.Id)) &&
                (search.Length == 0 || $"{t.Description} {t.UserDescription}".Contains(search, StringComparison.OrdinalIgnoreCase))).OrderBy(t => t.Date).ThenBy(t => t.Id);
        }
    }
    private IEnumerable<Transaction> VisibleRows => FilteredRows.Where(t => Categorization.HasCategory(State.Data, t, mode == "groups" ? groupCategory : null));
    private IEnumerable<Transaction> WalkRows
    {
        get
        {
            var linked = TransferMatching.ConfirmedTransactionIds(State.Data);
            return FilteredRows.Where(t => t.CategoryId == null && !State.Data.TransactionAllocations.Any(a => a.TransactionId == t.Id) && t.Kind != TransactionKind.Transfer && !linked.Contains(t.Id) && !skipped.Contains(t.Id));
        }
    }
    private Transaction? Current => WalkRows.FirstOrDefault();
    private IEnumerable<(Guid? Id, string Name, int Count)> Groups => new[] { ((Guid?)null, L["Uncategorized"].Value, FilteredRows.Count(t => Categorization.HasCategory(State.Data, t, null))) }
        .Concat(State.Data.Categories.Select(c => ((Guid?)c.Id, c.Name, FilteredRows.Count(t => Categorization.HasCategory(State.Data, t, c.Id)))).OrderByDescending(c => c.Item3 > 0).ThenBy(c => c.Name));
    protected override void OnParametersSet()
    {
        if (State.ReviewBatchId is { } review && review != lastReview) { batchId = review; lastReview = review; State.ReviewBatchId = null; includeTransfers = true; mode = "groups"; FilterChanged(); }
    }
    protected override void OnStateChanged()
    {
        if (lastOwner != State.OwnerId) { lastOwner = State.OwnerId; FilterChanged(); }
        if (groupCategory != null && !State.Data.Categories.Any(c => c.Id == groupCategory)) groupCategory = null;
        if (mode == "walk" && walkDraftId != Current?.Id) { ResetDraft(); PrefillWalk(); }
    }
    private void ResetDraft() { selected.Clear(); remember = false; applyMatches = false; rememberText = ""; ownDescription = ""; assignmentRevision = null; walkDraftId = null; }
    private void FilterChanged() { page = 0; skipped.Clear(); ResetDraft(); if (mode == "walk") PrefillWalk(); }
    private void SelectGroup(Guid? id) { groupCategory = id; page = 0; ResetDraft(); }
    private void SetMode(string value) { mode = value; FilterChanged(); }
    private void StartWalk() { mode = "walk"; skipped.Clear(); ResetDraft(); PrefillWalk(); }
    private void PrefillWalk() { if (Current is { } t) { walkDraftId = t.Id; assignmentRevision = State.Revision; ownDescription = t.UserDescription; rememberText = t.Description; } }
    private void Skip() { if (Current is { } t) skipped.Add(t.Id); ResetDraft(); PrefillWalk(); }
    private void LatestImport() { batchId = State.Data.ImportBatches.Where(b => !b.Undone).OrderByDescending(b => b.ImportedAt).FirstOrDefault()?.Id; FilterChanged(); }
    private void ClearFilters() { accountId = null; batchId = null; search = ""; includeTransfers = false; State.ReviewBatchId = null; FilterChanged(); }
    private void Select(Transaction t, bool value)
    {
        if (value) selected.Add(t.Id); else selected.Remove(t.Id);
        assignmentRevision ??= State.Revision;
        remember = false; applyMatches = false;
        var single = selected.Count == 1 ? State.Data.Transactions.FirstOrDefault(x => selected.Contains(x.Id)) : null;
        ownDescription = single?.UserDescription ?? ""; rememberText = single?.Description ?? "";
    }
    private async Task Assign()
    {
        var ids = mode == "walk" ? Current is { } t ? new HashSet<Guid> { t.Id } : [] : selected.Intersect(VisibleRows.Select(x => x.Id)).ToHashSet();
        var category = assignCategory; var text = remember ? rememberText : null;
        var linked = TransferMatching.ConfirmedTransactionIds(State.Data);
        var matches = remember && applyMatches ? FilteredRows.Where(t => t.Kind != TransactionKind.Transfer && !linked.Contains(t.Id) && t.CategoryId == null).Select(t => t.Id).ToHashSet() : null;
        var description = ids.Count == 1 ? ownDescription : null;
        var revision = assignmentRevision ?? State.Revision;
        if (await State.RunAsync(() =>
        {
            if (mode == "walk" && category == null) throw new InvalidOperationException(L["ChooseCategoryOrSkip"]);
            return State.SaveAsync(d => Categorization.Assign(d, ids, category, text, matches, description), revision);
        }, L["CategorySaved"]))
        { ResetDraft(); if (mode == "walk") PrefillWalk(); }
    }
    private void DeleteCategory(Category category)
    {
        var p = Categorization.PreviewCategoryDeletion(State.Data, category.Id);
        Ask(L["DeleteCategory"], L["DeleteCategoryQuestion", p.Name, p.TransactionCount, p.RecurringPaymentCount, p.RuleCount, p.BudgetOverrideCount, Money(p.MonthlyBudget)], d => Categorization.DeleteCategory(d, category.Id), L["DeleteCategory"]);
    }
}
