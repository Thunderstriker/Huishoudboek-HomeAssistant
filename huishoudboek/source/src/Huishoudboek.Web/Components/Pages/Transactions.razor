@page "/transacties"
@attribute [Authorize]
@inherits EditPageBase
<PageTitle>@L["Transactions"] · Huishoudboek</PageTitle>
<h1>@L["Transactions"]</h1>
<div class="actions"><button class="primary" disabled="@(State.Scope.Count == 0)" @onclick="() => Draft = EditorDraft.SimpleTransaction(State)">+ @L["AddExpense"]</button><button disabled="@(State.Scope.Count == 0)" @onclick="() => Draft = EditorDraft.SimpleTransaction(State, true)">+ @L["AddIncome"]</button><button disabled="@(State.Scope.Count == 0)" @onclick="() => Draft = EditorDraft.Transaction(State)">@L["AdvancedTransaction"]</button><a class="button" href="importeren">@L["ImportExcelCsv"]</a></div>
<div class="filters"><label>@L["Search"]<input type="search" @bind="search" @bind:event="oninput" @bind:after="Reset" placeholder="@L["TransactionSearchHint"]" /></label>
<label>@L["Account"]<select @bind="accountId" @bind:after="Reset"><option value="">@L["AllAccounts"]</option>@foreach (var a in State.Data.Accounts.Where(a => State.Scope.Contains(a.Id))) { <option value="@a.Id">@a.Name</option> }</select></label>
<label class="check"><input type="checkbox" @bind="allDates" @bind:after="Reset" />@L["AllDates"]</label></div>
@{ var rows = Rows.ToList(); page = Math.Min(page, Math.Max(0, (rows.Count - 1) / 100)); }
<section class="card"><MobileTransactions Transactions="rows.Skip(page * 100).Take(100)" TypeLabel="TransactionType" Edit="row => Draft = EditorDraft.Transaction(State, row)" Handle="OpenDetails" Delete="AskDelete" Recurring="OpenRecurring" /><div class="table-scroll desktop-transactions"><table id="transactions"><thead><tr><th>@L["Date"]</th><th>@L["Account"]</th><th>@L["Description"]</th><th class="money">@L["Amount"]</th><th>@L["CategoryType"]</th><th class="money">@L["Principal"]</th><th>@L["RecurringPayment"]</th><th class="money">@L["StatementBalance"]</th><th>@L["Actions"]</th></tr></thead><tbody>
@foreach (var row in rows.Skip(page * 100).Take(100))
{ <tr @key="row.Id"><td>@row.Date.ToString("dd-MM-yyyy") @if (row.Date > State.Today) { <span class="badge">@L["Planned"]</span> }</td><td>@State.AccountName(row.AccountId) @if (row.Kind == TransactionKind.Transfer) { <span>→ @State.AccountName(row.CounterAccountId)</span> }</td><td class="description">@if (row.UserDescription.Length > 0) { <strong>@row.UserDescription</strong><small>@row.Description</small> } else { @row.Description }</td><td class="money">@Money(row.Amount)</td><td><TransactionAllocationSummary Transaction="row" /><small class="badge">@TransactionType(row)</small></td><td class="money">@Money(row.PrincipalComponent)</td><td>@(State.Data.RecurringPayments.FirstOrDefault(r => r.Id == row.RecurringPaymentId)?.Name ?? "—")</td><td class="money">@(row.StatementBalance is { } balance ? Money(balance) : "—")</td><td><div class="actions"><button @onclick="() => Draft = EditorDraft.Transaction(State, row)">@L["Edit"]</button>@if (row.Kind == TransactionKind.Normal && !TransferMatching.IsInternal(State.Data, row)) { <button @onclick="() => OpenDetails(row)">@L["TransactionHandling"]</button> }@if (EditorDraft.CanCreateRecurring(State.Data, row)) { <button @onclick="() => OpenRecurring(row)">@L["LinkToRecurringPayment"]</button> }<button @onclick="() => AskDelete(row)">@L["Delete"]</button></div></td></tr> }
</tbody></table></div>@if (rows.Count == 0) { <p class="empty">@L["NoTransactions"]</p> }<Pager Count="rows.Count" @bind-Page="page" /></section>
<p class="muted">@L["PlannedTransactionsNote"]</p>
<p class="muted">@L["ExpenseUntilPaidNote"]</p>
@{ var claims = State.Data.ReimbursementClaims.Where(c => State.Data.Transactions.Any(t => t.Id == c.ExpenseTransactionId && State.Scope.Contains(t.AccountId) && t.Date <= State.Today)).ToList(); }
@if (claims.Count > 0)
{
    <section class="card"><h2>@L["ExpectedRepayments"] · @L["AllDates"]</h2>
        <p>@L["Outstanding"]: <strong>@Money(claims.Sum(c => TransactionAccounting.Outstanding(State.Data, c, State.Today)))</strong></p>
        <div class="table-scroll"><table><thead><tr><th>@L["Counterparty"]</th><th>@L["OriginalPurchase"]</th><th class="money">@L["ExpectedAmount"]</th><th class="money">@L["Received"]</th><th class="money">@L["Outstanding"]</th><th>@L["ExpectedRepaymentDate"]</th><th>@L["Actions"]</th></tr></thead><tbody>
        @foreach (var claim in claims)
        {
            var expense = State.Data.Transactions.Single(t => t.Id == claim.ExpenseTransactionId);
            <tr @key="claim.Id"><td>@claim.Counterparty @if (claim.IsClosed) { <span class="badge">@L["ExpectationClosed"]</span> }</td><td>@expense.Date.ToString("dd-MM-yyyy") · @expense.Description</td><td class="money">@Money(claim.ExpectedAmount)</td><td class="money">@Money(TransactionAccounting.Paid(State.Data, claim, State.Today))</td><td class="money">@Money(TransactionAccounting.Outstanding(State.Data, claim, State.Today))</td><td>@(claim.DueDate?.ToString("dd-MM-yyyy") ?? "—")</td><td><button @onclick="() => OpenDetails(expense)">@L["Edit"]</button></td></tr>
        }
        </tbody></table></div>
    </section>
}
@if (details is { } handling && State.Data.Transactions.FirstOrDefault(t => t.Id == handling.TransactionId) is { } entry)
{ <TransactionDetails @key="handling" Transaction="entry" Draft="handling" Closed="() => details = null" /> }
<EditDialogs Page="this" />
@if (recurringTransaction is { } recurringEntry)
{ <RecurringTransactionLink @key="recurringEntry.Id" Transaction="recurringEntry" Closed="() => recurringTransaction = null" Create="CreateRecurring" /> }
@code {
    private string search = ""; private Guid? accountId; private bool allDates; private int page;
    private TransactionDetailsDraft? details;
    private Transaction? recurringTransaction;
    private void OpenRecurring(Transaction transaction) => recurringTransaction = transaction;
    private void CreateRecurring(Transaction transaction) { recurringTransaction = null; Draft = EditorDraft.RecurringFromTransaction(State, transaction); }
    private void OpenDetails(Transaction transaction) => details = new(State, transaction);
    private void Reset() => page = 0;
    private IEnumerable<Transaction> Rows
    {
        get
        {
            var scope = State.Scope;
            var detailsText = string.IsNullOrWhiteSpace(search) ? null : TransactionAccounting.Lines(State.Data, State.Data.Transactions)
                .GroupBy(l => l.Transaction.Id).ToDictionary(g => g.Key, g => string.Join(" ", g.Select(l => State.CategoryName(l.CategoryId) + " " + l.Note)));
            return State.Data.Transactions.Where(t => (scope.Contains(t.AccountId) || t.CounterAccountId is { } counter && scope.Contains(counter)) &&
                (allDates || t.Date.Year == State.Year && t.Date.Month == State.Month) && (accountId == null || t.AccountId == accountId || t.CounterAccountId == accountId) &&
                (detailsText == null || $"{t.Description} {t.UserDescription} {State.CategoryName(t.CategoryId)} {State.AccountName(t.AccountId)} {State.AccountName(t.CounterAccountId)} {detailsText.GetValueOrDefault(t.Id)}".Contains(search, StringComparison.OrdinalIgnoreCase)))
                .OrderByDescending(t => t.Date).ThenBy(t => t.Id);
        }
    }
    private string TransactionType(Transaction t) => TransferMatching.IsInternal(State.Data, t) ?
        L[t.Kind == TransactionKind.Transfer ? "ManualTransfer" : "LinkedTransfer"] : State.Data.TransactionAllocations.Any(a => a.TransactionId == t.Id) ? L["AllocatedTransaction"] :
        State.Data.Categories.FirstOrDefault(c => c.Id == t.CategoryId) is { Purpose: not CategoryPurpose.Normal } category ? EditorDraft.PurposeLabel(category.Purpose) :
        L[t.Kind == TransactionKind.Mortgage ? "Mortgage" : t.Amount > 0 ? "IncomeSingle" : "Expense"];
    private void AskDelete(Transaction row) => Ask(L["DeleteTransaction"], L[row.Kind == TransactionKind.Transfer ?
        "DeleteManualTransferQuestion" : "DeleteTransactionQuestion"], d => HouseholdEdits.DeleteTransaction(d, row.Id), L["Delete"]);
}
