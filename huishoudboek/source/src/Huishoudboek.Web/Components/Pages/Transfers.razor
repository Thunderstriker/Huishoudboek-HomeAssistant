@page "/overboekingen"
@attribute [Authorize]
@inherits PageBase
<PageTitle>@L["LegacyTransferHistory"] · Huishoudboek</PageTitle>
<h1>@L["LegacyTransferHistory"]</h1>
<p class="notice">@L["TransferWorkflowRetired"]</p>
<div class="actions"><a class="button primary" href="categoriseren">@L["Categorize"]</a><a class="button" href="budgetten">@L["CategorySettings"]</a></div>
<p class="muted">@L["LegacyTransferNote"]</p>
@{
    var entries = State.Data.Transactions.ToDictionary(t => t.Id);
    var matches = State.Data.TransferMatches.Where(m => m.IsConfirmed &&
        (State.Scope.Contains(entries[m.DebitTransactionId].AccountId) || State.Scope.Contains(entries[m.CreditTransactionId].AccountId)))
        .OrderByDescending(m => entries[m.DebitTransactionId].Date).ToList();
    page = Math.Min(page, Math.Max(0, (matches.Count - 1) / 25));
}
@foreach (var match in matches.Skip(page * 25).Take(25))
{
    <section class="card" @key="match.Id"><TransferPair Debit="entries[match.DebitTransactionId]" Credit="entries[match.CreditTransactionId]" /></section>
}
<Pager Count="matches.Count" Size="25" @bind-Page="page" />
<p><a href="transacties">@L["Transactions"]</a> · @L["LegacyManualEntriesNote"]</p>
@code {
    private int page;
}
