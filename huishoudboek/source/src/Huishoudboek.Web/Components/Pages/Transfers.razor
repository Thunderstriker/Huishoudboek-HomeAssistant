@page "/overboekingen"
@attribute [Authorize]
@inherits EditPageBase
<PageTitle>@L["MatchTransfers"] · Huishoudboek</PageTitle>
<h1>@L["MatchTransfers"] · @L["AllDates"]</h1>
<p class="notice">@L["TransferMatchNote"]</p>
<div class="actions">
    <button class="@(mode == "suggestions" ? "primary" : "")" @onclick='() => SetMode("suggestions")'>@L["PossibleTransfers"]</button>
    <button class="@(mode == "confirmed" ? "primary" : "")" @onclick='() => SetMode("confirmed")'>@L["ConfirmedMatches"]</button>
    <button class="@(mode == "rejected" ? "primary" : "")" @onclick='() => SetMode("rejected")'>@L["NotTransfer"]</button>
</div>
<div class="filters">
    <label>@L["Account"]<select @bind="accountId" @bind:after="ResetPage"><option value="">@L["AllAccounts"]</option>@foreach (var account in State.Data.Accounts.Where(a => State.Scope.Contains(a.Id))) { <option value="@account.Id">@account.Name</option> }</select></label>
    <label>@L["SearchDescription"]<input type="search" @bind="search" @bind:event="oninput" @bind:after="ResetPage" /></label>
</div>
<p class="muted">@L["TransferOwnerFilterNote"]</p>
@if (mode == "suggestions")
{
    var candidates = TransferMatching.Candidates(State.Data, State.Today).Where(c => InFilter(c.Debit, c.Credit)).Take(501).ToList();
    var count = Math.Min(candidates.Count, 500);
    page = Math.Min(page, Math.Max(0, (count - 1) / 25));
    <p class="muted">@L["TransferSuggestionsNote", TransferMatching.SuggestionWindowDays] @(candidates.Count > 500 ? L["First500Suggestions"].Value : L["PossiblePairsCount", count].Value)</p>
    @foreach (var candidate in candidates.Take(500).Skip(page * 25).Take(25))
    {
        <section class="card" @key="(candidate.Debit.Id, candidate.Credit.Id)">
            <TransferPair Debit="candidate.Debit" Credit="candidate.Credit" />
            <p class="muted">@L["DaysApart", candidate.DaysApart] @L[candidate.HasAccountReference ? "AccountReferenceFound" : "NoAccountReference"]</p>
            @if (candidate.HasAlternatives) { <p class="notice warning">@L["MultipleTransferCandidates"]</p> }
            <p>@Effect(candidate.Debit, candidate.Credit)</p>
            <div class="actions"><button class="primary" @onclick="() => ConfirmPair(candidate.Debit, candidate.Credit)">@L["ConfirmTransfer"]…</button><button @onclick="() => RejectPair(candidate)">@L["NotTransfer"]…</button></div>
        </section>
    }
    @if (count == 0) { <section class="card"><p class="empty">@L["NoTransferPairs"]</p></section> }
    <Pager Count="count" Size="25" @bind-Page="page" />
}
else
{
    var entries = State.Data.Transactions.ToDictionary(t => t.Id);
    var matches = State.Data.TransferMatches.Where(m => m.IsConfirmed == (mode == "confirmed") && InFilter(entries[m.DebitTransactionId], entries[m.CreditTransactionId]))
        .OrderByDescending(m => entries[m.DebitTransactionId].Date).ToList();
    page = Math.Min(page, Math.Max(0, (matches.Count - 1) / 25));
    @foreach (var match in matches.Skip(page * 25).Take(25))
    {
        var debit = entries[match.DebitTransactionId]; var credit = entries[match.CreditTransactionId];
        <section class="card" @key="match.Id">
            <TransferPair Debit="debit" Credit="credit" />
            <p>@(match.IsConfirmed ? Effect(debit, credit) : L["RejectedTransferNote"].Value)</p>
            <div class="actions">
                <button @onclick="() => RemoveMatch(match)">@L[match.IsConfirmed ? "RemoveMatch" : "RemoveDecision"]…</button>
                <button @onclick="() => Draft = EditorDraft.Transaction(State, debit)">@L["EditDebit"]</button>
                <button @onclick="() => Draft = EditorDraft.Transaction(State, credit)">@L["EditCredit"]</button>
            </div>
        </section>
    }
    @if (matches.Count == 0) { <section class="card"><p class="empty">@L["NoTransferDecisions"]</p></section> }
    <Pager Count="matches.Count" Size="25" @bind-Page="page" />
}
<details class="card">
    <summary>@L["ManualTransferMatch"]</summary>
    <p class="muted">@L["ManualTransferNote"]</p>
    <div class="fields">
        <label>@L["FromAccount"]<select @bind="manualAccountId" @bind:after="ResetManual"><option value="">@L["ChooseAccount"]</option>@foreach (var account in State.Data.Accounts.Where(a => State.Scope.Contains(a.Id))) { <option value="@account.Id">@account.Name</option> }</select></label>
        <label>@L["SearchDebit"]<input type="search" @bind="manualSearch" @bind:event="oninput" @bind:after="ResetManual" /></label>
        <label>@L["Debit"]<select @bind="manualDebitId" @bind:after="ResetCredit"><option value="">@L["ChooseDebit"]</option>@foreach (var debit in ManualDebits) { <option value="@debit.Id">@EntryLabel(debit)</option> }</select></label>
        <label>@L["SearchReceipt"]<input type="search" @bind="manualCreditSearch" @bind:event="oninput" @bind:after="ResetCredit" /></label>
        <label>@L["Receipt"]<select @bind="manualCreditId"><option value="">@L["ChooseReceipt"]</option>@foreach (var credit in ManualCredits) { <option value="@credit.Id">@EntryLabel(credit)</option> }</select></label>
    </div>
    <p class="muted">@L["ManualTransferLimitNote"]</p>
    @if (ManualDebit is { } debitEntry && ManualCredit is { } creditEntry)
    {
        <TransferPair Debit="debitEntry" Credit="creditEntry" />
        <p>@Effect(debitEntry, creditEntry)</p>
        <button class="primary" @onclick="() => ConfirmPair(debitEntry, creditEntry)">@L["ConfirmTransfer"]…</button>
    }
</details>
<p class="muted">@L["TransferSavingsNote"]</p>
<EditDialogs Page="this" />
@code {
    private string mode = "suggestions", search = "", manualSearch = "", manualCreditSearch = "", lastRevision = "";
    private Guid? accountId, manualAccountId, manualDebitId, manualCreditId;
    private int page;
    private void ResetPage() => page = 0;
    private void SetMode(string value) { mode = value; ResetPage(); }
    private void ResetManual() { manualDebitId = null; manualCreditId = null; }
    private void ResetCredit() => manualCreditId = null;
    protected override void OnStateChanged()
    {
        if (lastRevision != State.Revision) { lastRevision = State.Revision; ResetManual(); }
        if (manualAccountId != null && !State.Scope.Contains(manualAccountId.Value)) { manualAccountId = null; ResetManual(); }
    }
    private bool InFilter(Transaction debit, Transaction credit) =>
        (State.Scope.Contains(debit.AccountId) || State.Scope.Contains(credit.AccountId)) &&
        (accountId == null || debit.AccountId == accountId || credit.AccountId == accountId) &&
        (string.IsNullOrWhiteSpace(search) || $"{debit.Description} {debit.UserDescription} {credit.Description} {credit.UserDescription}".Contains(search, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<Transaction> AvailableEntries
    {
        get
        {
            var linked = TransferMatching.ConfirmedTransactionIds(State.Data);
            return State.Data.Transactions.Where(t => TransferMatching.IsEligible(t, State.Data) && t.Date <= State.Today && !linked.Contains(t.Id));
        }
    }
    private IEnumerable<Transaction> ManualDebits => AvailableEntries.Where(t => t.Amount < 0 && t.AccountId == manualAccountId && State.Scope.Contains(t.AccountId) &&
        (string.IsNullOrWhiteSpace(manualSearch) || $"{t.Description} {t.UserDescription}".Contains(manualSearch, StringComparison.OrdinalIgnoreCase))).OrderByDescending(t => t.Date).Take(100);
    private Transaction? ManualDebit => ManualDebits.FirstOrDefault(t => t.Id == manualDebitId);
    private IEnumerable<Transaction> ManualCredits => ManualDebit is { } debit ? AvailableEntries.Where(t => t.Amount == -debit.Amount && t.AccountId != debit.AccountId &&
        (string.IsNullOrWhiteSpace(manualCreditSearch) || $"{State.AccountName(t.AccountId)} {t.Description} {t.UserDescription}".Contains(manualCreditSearch, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(t => Math.Abs(t.Date.DayNumber - debit.Date.DayNumber)).Take(100) : [];
    private Transaction? ManualCredit => ManualCredits.FirstOrDefault(t => t.Id == manualCreditId);
    private string EntryLabel(Transaction entry) => $"{entry.Date:dd-MM-yyyy} · {State.AccountName(entry.AccountId)} · {Money(entry.Amount)} · {entry.Description}";
    private string Effect(Transaction debit, Transaction credit)
    {
        var from = State.Data.Accounts.Single(a => a.Id == debit.AccountId);
        var to = State.Data.Accounts.Single(a => a.Id == credit.AccountId);
        var savings = from.Kind == AccountKind.Current && to.Kind != AccountKind.Current ? -debit.Amount :
            from.Kind != AccountKind.Current && to.Kind == AccountKind.Current ? debit.Amount : 0;
        var date = from.Kind == AccountKind.Current ? debit.Date : credit.Date;
        return L["TransferEffect"].Value + " " +
            (savings == 0 ? L["NoSavingsContribution"].Value : L["SavingsContribution", Money(savings), date.ToString("dd-MM-yyyy")].Value);
    }
    private void ConfirmPair(Transaction debit, Transaction credit)
    {
        var debitId = debit.Id; var creditId = credit.Id; var today = State.Today;
        Ask(L["ConfirmInternalTransfer"], $"{EntryLabel(debit)}\n{EntryLabel(credit)}\n\n{Effect(debit, credit)}\n{L["ConfirmTransferQuestion"]}",
            d => TransferMatching.Confirm(d, debitId, creditId, today), L["ConfirmTransfer"]);
    }
    private void RejectPair(TransferCandidate candidate)
    {
        var debitId = candidate.Debit.Id; var creditId = candidate.Credit.Id; var today = State.Today;
        Ask(L["RejectSuggestion"], L["RejectTransferQuestion"],
            d => TransferMatching.Reject(d, debitId, creditId, today), L["NotTransfer"]);
    }
    private void RemoveMatch(TransferMatch match)
    {
        var id = match.Id;
        Ask(L["RemoveTransferDecision"], L[match.IsConfirmed ? "RemoveTransferMatchQuestion" : "RemoveTransferRejectionQuestion"], d => TransferMatching.Remove(d, id), L["RemoveDecision"]);
    }
}
