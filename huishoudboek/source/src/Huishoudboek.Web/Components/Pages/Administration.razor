@page "/beheer"
@attribute [Authorize]
@inherits EditPageBase
@inject IWebAdministration Backend
@inject WebHostSettings HostSettings
<PageTitle>@L["AdministrationImport"] · Huishoudboek</PageTitle>
<h1>@L["AdministrationImport"]</h1>
<section class="card"><h2>@L["YourRecords"]</h2><div class="actions">
    <a class="button primary" href="importeren">@L["ImportExcelCsv"]</a><a class="button" href="website/export" data-enhance-nav="false">@L["ExportAllCsv"]</a><a class="button" href="website/backup" data-enhance-nav="false">@L["CreateBackup"]</a>
</div><p class="muted">@L["BackupSecurityNote"]</p>
<details id="database" open="@(HostSettings.HomeAssistant && State.Data.Accounts.Count == 0)"><summary>@L["ImportRestoreDatabase"]</summary>
<p>@L["DatabasePreservesNote"]</p>
@if (HostSettings.HomeAssistant) { <p>@L["HomeAssistantStorageNote"]</p> }
<p class="notice warning">@L["DatabaseRestoreWarning"]</p>
<label>@L["DatabaseFile"]<InputFile id="restoreFile" OnChange="SelectBackup" accept=".db" /></label><button disabled="@(restoreFile == null)" @onclick="() => restoreConfirm = true">@L["ImportDatabase"]…</button></details></section>
<section class="card"><h2>@L["SetupAndNavigation"]</h2>
    <div class="actions"><a class="button" href="instellen">@L["SetupTitle"]</a><a class="button" href="weekcontrole">@L["WeeklyReviewTitle"]</a></div>
    <WeeklyReviewVisibility />
</section>
<section class="card"><h2>@L["ImportHistory"]</h2><div class="table-scroll"><table><thead><tr><th>@L["Date"]</th><th>@L["File"]</th><th>@L["Account"]</th><th>@L["Rows"]</th><th>@L["Status"]</th><th></th></tr></thead><tbody>
@foreach (var b in State.Data.ImportBatches.OrderByDescending(b => b.ImportedAt))
{ <tr><td>@b.ImportedAt.ToString("dd-MM-yyyy HH:mm")</td><td>@b.FileName</td><td>@State.AccountName(b.AccountId)</td><td>@b.RowCount</td><td>@L[b.Undone ? "Undone" : "Processed"]</td><td>@if (!b.Undone) { <button @onclick="() => Undo(b)">@L["UndoEntireImport"]</button> }</td></tr> }
</tbody></table></div></section>
<section class="card"><h2>@L["AutomaticCategorization"]</h2><div class="actions"><button class="primary" @onclick="() => Draft = EditorDraft.Rule(State)">+ @L["Rule"]</button><button @onclick="ApplyRules">@L["ApplyExistingTransactions"]</button></div>
<p class="muted">@L["RulesOrderNote"]</p>
<div class="table-scroll"><table><thead><tr><th>@L["Order"]</th><th>@L["DescriptionContains"]</th><th>@L["Category"]</th><th></th></tr></thead><tbody>
@foreach (var r in State.Data.Rules)
{ <tr><td>@(State.Data.Rules.IndexOf(r) + 1)</td><td>@r.Contains</td><td>@State.CategoryName(r.CategoryId)</td><td><div class="actions"><button @onclick="() => Draft = EditorDraft.Rule(State, r)">@L["Edit"]</button><button @onclick="() => DeleteRule(r)">@L["Delete"]</button></div></td></tr> }
</tbody></table></div></section>
<EditDialogs Page="this" />
@if (restoreConfirm)
{ <Confirm Title="@L["ImportDatabase"]" Text="@L["RestoreDatabaseQuestion"]" ActionLabel="@L["ImportDatabase"]" Cancel="() => restoreConfirm = false" Accept="Restore" /> }
@code {
    private IBrowserFile? restoreFile; private string restoreRevision = ""; private bool restoreConfirm;
    private void SelectBackup(InputFileChangeEventArgs args) { restoreFile = args.File; restoreRevision = State.Revision; }
    private void Undo(ImportBatch batch) => Ask(L["UndoImport"], L["UndoImportQuestion"], d => HouseholdEdits.UndoImport(d, batch.Id), L["UndoImport"]);
    private void DeleteRule(CategorizationRule rule) => Ask(L["DeleteRule"], L["DeleteRuleQuestion"], d => d.Rules.RemoveAll(r => r.Id == rule.Id), L["DeleteRule"]);
    private void ApplyRules() => Ask(L["ApplyRules"], L["ApplyRulesQuestion"], HouseholdEdits.ApplyRules, L["ApplyRules"]);
    private async Task Restore()
    {
        if (restoreFile == null) return;
        if (await State.RunAsync(async () =>
        {
            if (restoreFile.Size > 64L * 1024 * 1024) throw new InvalidDataException(L["BackupTooLarge"]);
            await using var stream = restoreFile.OpenReadStream(64L * 1024 * 1024);
            await Backend.RestoreAsync(stream, restoreRevision, CancellationToken.None);
            State.OwnerId = null; State.ReviewBatchId = null; await State.LoadAsync();
        }, L["DatabaseImported"]))
        { restoreConfirm = false; restoreFile = null; }
    }
}
