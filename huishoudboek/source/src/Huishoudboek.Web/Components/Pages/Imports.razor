@page "/importeren"
@attribute [Authorize]
@inherits PageBase
@inject IWebAdministration Backend
@inject NavigationManager Navigation
<PageTitle>@L["Import"] · Huishoudboek</PageTitle>
<h1>@L["ImportExcelCsv"]</h1>
<p class="notice">@L["ImportAccountNote"]</p>
<p class="muted">@L["AfterImportBothAccounts"] <a href="overboekingen">@L["MatchTransfers"]</a> @L["ImportTransferReportingNote"]</p>
<section class="card">
    <label>@L["ImportFileHint"]<InputFile id="importFile" OnChange="Upload" accept=".xls,.xlsx,.csv" /></label>
    <div class="fields"><label>@L["ImportAccount"]<select id="importAccount" @bind="accountId" @bind:after="Invalidate"><option value="">@L["ChooseAccount"]</option>@foreach (var a in State.Data.Accounts) { <option value="@a.Id">@a.Name</option> }</select></label>
    <label>@L["FromInclusive"]<InputDate id="from" @bind-Value="from" @bind-Value:after="Invalidate" /></label><label>@L["ThroughInclusive"]<InputDate id="through" @bind-Value="through" @bind-Value:after="Invalidate" /></label></div>
    <details open="@settingsOpen"><summary>@L["ImportSettings"]</summary>
        <div class="fields"><label>@L["Worksheet"]<select @bind="worksheet" @bind:after="Invalidate"><option value="">@(sheets.Count == 0 ? "CSV" : L["FirstWorksheet"].Value)</option>@foreach (var sheet in sheets) { <option value="@sheet">@sheet</option> }</select></label>
        <label>@L["SavedProfile"]<select @bind="profileChoice" @bind:after="UseProfile"><option value="">@L["AutoDetect"]</option><optgroup label="@L["ReadyMadeBankProfiles"]">@foreach (var p in BankImportProfiles.All) { <option value="@($"bank:{p.Id}")">@p.Name</option> }</optgroup><optgroup label="@L["SavedProfile"]">@foreach (var p in State.Data.ImportProfiles) { <option value="@p.Id">@p.Name</option> }</optgroup></select></label>
        <label class="check"><input type="checkbox" @bind="windows1252" @bind:after="Invalidate" />@L["Windows1252Hint"]</label></div>
        @if (profile != null)
        {
            <div class="fields"><label>@L["ProfileName"]<input @bind="profile.Name" @bind:after="Invalidate" /></label><label>@L["NumberCulture"]<select @bind="profile.CultureName" @bind:after="Invalidate"><option value="nl-NL">@L["DutchNumberFormat"]</option><option value="nl-BE">@L["BelgianDutch"]</option><option value="en-US">@L["EnglishNumberFormat"]</option><option value="de-DE">@L["GermanNumberFormat"]</option></select></label><label>@L["OptionalDateFormat"]<input @bind="profile.DateFormat" @bind:after="Invalidate" placeholder="dd/MM/yyyy" /></label>
            @foreach (var column in Columns)
            { <label>@L[column.Label]<select value="@ProfileValue(column.Key)" @onchange="e => MapColumn(column.Key, e.Value?.ToString() ?? string.Empty)"><option value="">@L["DoNotUse"]</option>@if (ProfileValue(column.Key) is { Length: > 0 } mapped && !headers.Contains(mapped)) { <option value="@mapped">@mapped</option> }@foreach (var header in headers) { <option value="@header">@header</option> }</select></label> }
            </div>
        }
        else { <p class="muted">@L["PreviewColumnNote"]</p> }
    </details>
    <p class="muted">@L["BankProfilesNote"]</p>
    <div class="actions"><button id="preview" class="primary" disabled="@(uploadId == null || accountId == null)" @onclick="Preview">@L["ProcessPreview"]</button></div>
    <p class="muted">@(fileName ?? L["NoFileSelected"].Value) · @L["UploadExpiryNote"]</p>
</section>
@if (preview != null)
{
    <section class="card" id="previewPanel"><h2>@L["UnsavedImportPreview"]</h2><p>@L["PreviewRowsNote", rows.Count, rows.Count(r => r.Include)]</p>
    <div class="table-scroll"><table><thead><tr><th>@L["Save"]</th><th>@L["Row"]</th><th>@L["Date"]</th><th>@L["Description"]</th><th class="money">@L["Amount"]</th><th>@L["Category"]</th><th>@L["Check"]</th></tr></thead><tbody>
    @foreach (var row in rows.Skip(page * 100).Take(100))
    { <tr @key="row.Number"><td><input type="checkbox" aria-label="@L["SelectImportRow"]" @bind="row.Include" disabled="@(!row.Source.IsValid)" /></td><td>@row.Number</td><td>@row.Source.Date?.ToString("dd-MM-yyyy")</td><td class="description">@row.Source.Description</td><td class="money">@(row.Source.Amount is { } amount ? Money(amount) : "—")</td>
    <td><select aria-label="@L["ImportRowCategory"]" value="@row.Source.CategoryId" @onchange="e => Adjust(row, e)">@foreach (var category in preview.Categories) { <option value="@category.Id">@(category.Id == null ? L["Uncategorized"].Value : category.Name)</option> }</select></td>
    <td class="description"><span class="badge">@row.Source.Kind</span><br />@row.Source.Note</td></tr> }
    </tbody></table></div><Pager Count="rows.Count" @bind-Page="page" />
    <button id="commit" class="primary" disabled="@(!rows.Any(r => r.Include))" @onclick="() => commitConfirm = true">@L["SaveSelectedRows"]…</button></section>
}
@if (commitConfirm && preview != null)
{ <Confirm Title="@L["CommitImport"]" Text="@L["CommitImportQuestion", rows.Count(r => r.Include), State.AccountName(accountId)]" ActionLabel="@L["SaveImport"]" Cancel="() => commitConfirm = false" Accept="Commit" /> }
@if (result is { } saved)
{
    <Modal Title="@L["ImportCompleteBalanceCheck"]" Cancel="OpenReview">
        <p>@L["ImportSavedCount", saved.Count, skippedCount]</p>
        <h3>@L["BalanceAsOf", saved.Balance.AsOf.ToString("dd-MM-yyyy"), Money(saved.Balance.CalculatedBalance)]</h3>
        @if (saved.Balance.StatementBalance is { } bank)
        { <p>@L["StatementBalance"]: @Money(bank).</p><p class="notice @(saved.Balance.Difference == 0 ? "success" : "warning")">@(saved.Balance.Difference == 0 ? L["BalanceMatches"].Value : L["BalanceDifference", Money(saved.Balance.Difference!.Value)].Value)</p> }
        else { <p class="notice warning">@L["NoBalanceComparison"]: @BalanceReason(saved.Balance.Status)</p> }
        <p class="muted">@L["BalanceCheckNote"]</p>
        <p>@L["InvalidFutureRows", saved.Balance.InvalidRowCount, saved.Balance.FutureRowCount]</p>
        <button class="primary" autofocus @onclick="OpenReview">@L["ContinueCheckCategories"]</button>
        <a class="button" href="overboekingen">@L["CheckOwnTransfers"]</a>
    </Modal>
}
@code {
    private Guid? uploadId, accountId; private string? fileName; private string worksheet = "", profileChoice = "";
    private IReadOnlyList<string> sheets = [], headers = [];
    private bool windows1252, settingsOpen = true, commitConfirm;
    private DateOnly from, through; private ImportProfile? profile; private PreviewResponse? preview; private CommitImportResponse? result;
    private List<ImportDraftRow> rows = []; private int page, skippedCount;
    private readonly CancellationTokenSource cancellation = new();
    private static readonly (string Key, string Label)[] Columns = [
        (nameof(ImportProfile.DateColumn), "Date"), (nameof(ImportProfile.DescriptionColumn), "Description"), (nameof(ImportProfile.ExtraDescriptionColumn), "ExtraDescription"),
        (nameof(ImportProfile.AmountColumn), "SignedAmount"), (nameof(ImportProfile.DebitColumn), "DebitAlternative"), (nameof(ImportProfile.CreditColumn), "CreditAlternative"),
        (nameof(ImportProfile.DirectionColumn), "DebitCreditIndicator"), (nameof(ImportProfile.CurrencyColumn), "Currency"), (nameof(ImportProfile.AccountReferenceColumn), "OriginatingAccount"),
        (nameof(ImportProfile.BalanceColumn), "BalanceAfterEntry"), (nameof(ImportProfile.FallbackDescriptionColumn), "FallbackTransactionType")];
    protected override void OnInitialized()
    {
        base.OnInitialized(); from = new DateOnly(State.Year, State.Month, 1); through = from.AddMonths(1).AddDays(-1); accountId = State.Data.Accounts.FirstOrDefault()?.Id;
    }
    private void Invalidate() { preview = null; rows.Clear(); commitConfirm = false; settingsOpen = true; }
    private async Task Upload(InputFileChangeEventArgs args)
    {
        Invalidate(); uploadId = null; profile = null; profileChoice = ""; headers = []; sheets = []; worksheet = "";
        await State.RunAsync(async () =>
        {
            var file = args.File; fileName = file.Name;
            if (file.Size > 50L * 1024 * 1024) throw new InvalidDataException(L["ImportFileTooLarge"]);
            await using var stream = file.OpenReadStream(50L * 1024 * 1024, cancellation.Token);
            var response = await Backend.UploadAsync(stream, file.Name, cancellation.Token); uploadId = response.UploadId; sheets = response.Worksheets;
        }, L["FileReadyForPreview"]);
    }
    private void UseProfile()
    {
        var bank = profileChoice.StartsWith("bank:", StringComparison.Ordinal);
        var id = Guid.TryParse(bank ? profileChoice[5..] : profileChoice, out var parsed) ? parsed : (Guid?)null;
        profile = (bank ? BankImportProfiles.All : State.Data.ImportProfiles).FirstOrDefault(p => p.Id == id) is { } selected ? selected with { } : null;
        Invalidate();
    }
    private string ProfileValue(string key) => (string?)typeof(ImportProfile).GetProperty(key)!.GetValue(profile) ?? "";
    private void MapColumn(string key, string value) { typeof(ImportProfile).GetProperty(key)!.SetValue(profile, value); Invalidate(); }
    private async Task Preview()
    {
        if (uploadId == null || accountId == null) return;
        Invalidate();
        await State.RunAsync(async () =>
        {
            preview = await Backend.PreviewAsync(new(uploadId.Value, accountId.Value, from, through, profile, worksheet.Length == 0 ? null : worksheet, windows1252), State.Revision);
            profile = preview.Profile with { }; headers = preview.Headers; rows = preview.Rows.Select(r => new ImportDraftRow(r)).ToList(); page = 0; settingsOpen = rows.Count == 0;
        }, L["PreviewProcessed"]);
    }
    private async Task Adjust(ImportDraftRow row, ChangeEventArgs args)
    {
        if (preview == null) return;
        var id = Guid.TryParse(args.Value?.ToString(), out var parsed) ? parsed : (Guid?)null;
        await State.RunAsync(async () =>
        {
            var keep = row.Include;
            row.Source = await Backend.AdjustAsync(new(preview.PreviewId, row.Number, null, id, true));
            row.Include = row.Source.IsValid && keep;
        });
    }
    private async Task Commit()
    {
        if (preview == null) return;
        await State.RunAsync(async () =>
        {
            var selections = rows.Where(r => r.Include).Select(r => new ImportSelection(r.Number, r.Source.CategoryId, null)).ToArray();
            result = await Backend.CommitAsync(new(preview.PreviewId, selections), preview.Revision);
            skippedCount = rows.Count - selections.Length; commitConfirm = false; preview = null; rows.Clear(); uploadId = null;
            State.OwnerId = null; State.ReviewBatchId = result.BatchId; await State.LoadAsync();
        }, L["ImportSaved"]);
    }
    private void OpenReview() { result = null; Navigation.NavigateTo("categoriseren"); }
    private string BalanceReason(StatementBalanceStatus status) => L[status switch { StatementBalanceStatus.Missing => "MissingStatementBalance", StatementBalanceStatus.Ambiguous => "AmbiguousStatementBalance", StatementBalanceStatus.InvalidRows => "InvalidBalanceRows", StatementBalanceStatus.NoActualRows => "NoActualBalanceRows", _ => "NoBankReference" }];
    public override void Dispose() { cancellation.Cancel(); cancellation.Dispose(); base.Dispose(); }
    private sealed class ImportDraftRow(PreviewRow source)
    { public PreviewRow Source { get; set; } = source; public int Number => Source.RowNumber; public bool Include { get; set; } = source.Include; }
}
