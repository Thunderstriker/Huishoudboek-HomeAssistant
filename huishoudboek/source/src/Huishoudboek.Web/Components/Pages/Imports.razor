@page "/importeren"
@attribute [Authorize]
@inherits PageBase
@inject IWebAdministration Backend
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>@L["Import"] · Huishoudboek</PageTitle>
<h1>@L["ImportBankStatement"]</h1>
@if (uploadId != null || preview != null) { <NavigationLock ConfirmExternalNavigation="true" OnBeforeInternalNavigation="BeforeNavigate" /> }
<ol class="import-stepper" aria-label="@L["ImportSteps"]">
    @for (var n = 1; n <= StepKeys.Length; n++)
    {
        <li class="@(step == n ? "current" : step > n ? "complete" : "")" aria-current="@(step == n ? "step" : null)"><span aria-hidden="true">@n</span>@L[StepKeys[n - 1]]</li>
    }
</ol>
@if (step == 1)
{
    <section class="card">
        <p>@L["ImportAccountNote"]</p>
        @if (State.Data.Accounts.Count == 0)
        { <a class="button primary" href="instellen">@L["GetStarted"]</a> }
        else
        {
            <div class="fields"><label>@L["ImportAccount"]<select id="importAccount" @bind="accountId" @bind:after="Invalidate"><option value="">@L["ChooseAccount"]</option>@foreach (var a in State.Data.Accounts) { <option value="@a.Id">@a.Name</option> }</select></label>
                <label>@L["ImportFileHint"]<InputFile id="importFile" OnChange="Upload" accept=".xls,.xlsx,.csv" /></label></div>
            @if (uploadId != null) { <p><strong>@fileName</strong> · @L["UploadExpiryNote"]</p> }
            @if (requiresMapping) { <p class="notice warning" role="status">@L["ImportMappingNeeded"]</p> }
            <details open="@settingsOpen" id="import-options"><summary>@L["ImportOptions"]</summary>
                <p class="muted">@L["ImportOptionalPeriod"]</p>
                <div class="fields"><label>@L["FromInclusive"]<InputDate id="from" @bind-Value="from" @bind-Value:after="Invalidate" /></label><label>@L["ThroughInclusive"]<InputDate id="through" @bind-Value="through" @bind-Value:after="Invalidate" /></label></div>
                <div class="fields"><label>@L["SavedProfile"]<select @bind="profileChoice" @bind:after="UseProfile"><option value="">@L["AutoDetect"]</option><optgroup label="@L["ReadyMadeBankProfiles"]">@foreach (var p in BankImportProfiles.All) { <option value="@($"bank:{p.Id}")">@p.Name</option> }</optgroup><optgroup label="@L["SavedProfile"]">@foreach (var p in State.Data.ImportProfiles) { <option value="@p.Id">@p.Name</option> }</optgroup></select></label>
                @if (sheets.Count > 0)
                { <label>@L["Worksheet"]<select @bind="worksheet" @bind:after="ChangeSourceSettings"><option value="">@L["FirstWorksheet"]</option>@foreach (var sheet in sheets) { <option value="@sheet">@sheet</option> }</select></label> }
                <label class="check"><input type="checkbox" @bind="windows1252" @bind:after="ChangeSourceSettings" />@L["Windows1252Hint"]</label></div>
                @if (profile != null && headers.Count > 0)
                {
                    <div class="fields"><label>@L["ProfileName"]<input @bind="profile.Name" @bind:after="Invalidate" /></label><label>@L["NumberCulture"]<select @bind="profile.CultureName" @bind:after="Invalidate"><option value="nl-NL">@L["DutchNumberFormat"]</option><option value="nl-BE">@L["BelgianDutch"]</option><option value="en-US">@L["EnglishNumberFormat"]</option><option value="de-DE">@L["GermanNumberFormat"]</option></select></label><label>@L["OptionalDateFormat"]<input @bind="profile.DateFormat" @bind:after="Invalidate" placeholder="dd/MM/yyyy" /></label>
                    @foreach (var column in Columns)
                    { <label>@L[column.Label]<select id="@($"import-column-{column.Key}")" aria-label="@L[column.Label]" value="@ProfileValue(column.Key)" @onchange="e => MapColumn(column.Key, e.Value?.ToString() ?? string.Empty)"><option value="">@L["DoNotUse"]</option>@if (ProfileValue(column.Key) is { Length: > 0 } mapped && !headers.Contains(mapped)) { <option value="@mapped">@mapped</option> }@foreach (var header in headers) { <option value="@header">@header</option> }</select></label> }
                    </div>
                }
                else { <p class="muted">@L["PreviewColumnNote"]</p> }
                <p class="muted">@L["BankProfilesNote"]</p>
            </details>
            @if (!DatesValid) { <p class="notice warning" role="status">@L["ImportDatesInvalid"]</p> }
            <button id="preview" class="primary" disabled="@(uploadId == null || accountId == null || !DatesValid)" @onclick="Preview">@L["ImportReviewEntries"]</button>
        }
    </section>
}
@if (preview != null && step >= 2)
{
    <section class="card" id="previewPanel"><h2>@L["UnsavedImportPreview"]</h2>
    <dl class="transaction-details import-context"><dt>@L["ImportAccount"]</dt><dd><strong>@State.AccountName(accountId)</strong></dd><dt>@L["File"]</dt><dd>@fileName</dd><dt>@L["HistoryPeriod"]</dt><dd>@PeriodSummary</dd></dl>
    <div class="actions"><button @onclick="() => BackToFile(false)">@L["ImportChangeFile"]</button><button @onclick="() => BackToFile(true)">@L["ImportOptions"]</button></div>
    <p class="muted">@L["ImportDetectedProfile", preview.Profile.Name]</p>
    <p>@L["PreviewRowsNote", rows.Count, rows.Count(r => r.Include)]</p>
    <p class="notice import-duplicate-summary" role="status">@L["ImportDuplicateSummary", rows.Count(r => r.Source.IsValid && r.Source.DuplicateStatus == ImportDuplicateStatus.New), rows.Count(r => r.Source.DuplicateStatus == ImportDuplicateStatus.AlreadyImported), rows.Count(r => r.Source.DuplicateStatus == ImportDuplicateStatus.NeedsReview)]</p>
    <p class="muted">@L["ImportDuplicateHelp"]</p>
    <p class="muted">@L["ImportReviewHint"]</p>
    <div class="actions"><button @onclick="SelectValid">@L["ImportSelectValid"]</button><button @onclick="ClearSelection">@L["ImportClearSelection"]</button><label class="check"><input type="checkbox" @bind="exceptionsOnly" @bind:after="() => page = 0" />@L["ImportExceptionsOnly"] (@rows.Count(r => r.NeedsReview(State.Today)))</label></div>
    @{ var displayed = rows.Where(r => !exceptionsOnly || r.NeedsReview(State.Today)).ToList(); page = Math.Min(page, Math.Max(0, (displayed.Count - 1) / 100)); }
    <div class="table-scroll import-review"><table><thead><tr><th>@L["Save"]</th><th>@L["Row"]</th><th>@L["Date"]</th><th>@L["Description"]</th><th class="money">@L["Amount"]</th><th>@L["Category"]</th><th>@L["Check"]</th></tr></thead><tbody>
    @foreach (var row in displayed.Skip(page * 100).Take(100))
    { <tr @key="row.Number" class="@(row.NeedsReview(State.Today) ? "import-exception" : "")"><td data-label="@L["Save"]"><input type="checkbox" aria-label="@($"{L["SelectImportRow"]} {row.Number}")" @bind="row.Include" @bind:after="UnconfirmPartialCoverage" disabled="@(!row.Source.IsValid)" /></td><td data-label="@L["Row"]">@row.Number</td><td data-label="@L["Date"]">@row.Source.Date?.ToString("dd-MM-yyyy") @if (row.Source.Date > State.Today) { <small class="badge">@L["Planned"]</small> }</td><td class="description" data-label="@L["Description"]">@if (row.Source.RecognizedName.Length > 0) { <strong>@row.Source.RecognizedName</strong><details><summary>@L["OriginalDescription"]</summary>@row.Source.Description</details> } else { @row.Source.Description }</td><td class="money" data-label="@L["Amount"]">@(row.Source.Amount is { } amount ? Money(amount) : "—")</td>
    <td data-label="@L["Category"]"><select aria-label="@($"{L["ImportRowCategory"]} {row.Number}")" value="@row.Source.CategoryId" @onchange="e => Adjust(row, e)" disabled="@(!row.Source.IsValid)">@foreach (var category in preview.Categories) { <option value="@category.Id">@(category.Id == null ? L["Uncategorized"].Value : State.Data.Categories.FirstOrDefault(c => c.Id == category.Id) is { } stored ? EditorDraft.CategoryLabel(State.Data, stored) : category.Name)</option> }</select></td>
    <td class="description" data-label="@L["Check"]"><span class="badge">@(State.Data.Categories.FirstOrDefault(c => c.Id == row.Source.CategoryId) is { Purpose: not CategoryPurpose.Normal } selectedCategory ? EditorDraft.PurposeLabel(selectedCategory.Purpose) : row.Source.Kind)</span>
        @if (row.Source.IsValid) { <span class="badge import-status" data-status="@row.Source.DuplicateStatus">@L[row.Source.DuplicateStatus switch { ImportDuplicateStatus.AlreadyImported => "ImportAlreadyImported", ImportDuplicateStatus.NeedsReview => "ImportDuplicateReview", _ => "ImportNewRow" }]</span> }
        @if (row.Source.MatchedTransactionId is { } matchedId) { <a class="text-link" href="@UiNavigation.Transactions(transaction: matchedId)">@L["ImportViewExisting"]</a> }
        @if (row.Source.RecurringPaymentId != null) { <small>@L["ScheduledPaymentLinked"] · @row.Source.RecurringOccurrenceDate?.ToString("dd-MM-yyyy")</small> }
        else if (row.Source.HasPlannedIdentity) { <small>@L["RecognizedNotLinked"]</small> }
        @if (row.Source.AmbiguousIdentity) { <small class="notice warning">@L["RecognitionAmbiguousImport"]</small> }
        <br />@row.Source.Note</td></tr> }
    </tbody></table></div>@if (displayed.Count == 0 && exceptionsOnly) { <p role="status">@L["ImportNoExceptions"]</p> }<Pager Count="displayed.Count" @bind-Page="page" />
    @if (from is { } start && through is { } end)
    {
        <label class="check"><input type="checkbox" @bind="confirmCompletePeriod" disabled="@(rows.Any(r => !r.AccountsForCoverage) || start > State.Today)" />@L["ImportConfirmCompletePeriod", start.ToString("dd-MM-yyyy"), (end < State.Today ? end : State.Today).ToString("dd-MM-yyyy")]</label>
        <p class="muted">@L["ImportCoverageHelp"]</p>
    }
    else { <p class="muted">@L["ImportCoverageExplicitDates"] <button class="text-button" @onclick="() => BackToFile(true)">@L["ImportSetDates"]</button></p> }
    <div class="import-selection-bar"><p role="status">@L["ImportSelectionSummary", rows.Count(r => r.Include), rows.Count, Money(rows.Where(r => r.Include).Sum(r => r.Source.Amount ?? 0)), rows.Count(r => !r.Source.IsValid)]</p><button id="commit" class="primary" disabled="@(!rows.Any(r => r.Include) && !CanConfirmCoverage && !OnlyExistingRows)" @onclick="() => { step = 3; commitConfirm = true; }">@L[rows.Any(r => r.Include) ? "SaveSelectedRows" : "ImportFinishCheck"]…</button></div></section>
}
@if (commitConfirm && preview != null)
{ <Confirm Title="@L["CommitImport"]" Text="@CommitQuestion" ActionLabel="@L["SaveImport"]" Cancel="() => { commitConfirm = false; step = 2; }" Accept="Commit" /> }
@if (result is { } saved)
{
    <Modal Title="@L["ImportCompleteBalanceCheck"]" Cancel="OpenReview">
        <p>@L["ImportSavedCount", saved.Count, skippedCount]</p>
        @if (matchedSkippedCount > 0) { <p class="notice success">@L["ImportAlreadySkipped", matchedSkippedCount]</p> }
        <h3>@L["BalanceAsOf", saved.Balance.AsOf.ToString("dd-MM-yyyy"), Money(saved.Balance.CalculatedBalance)]</h3>
        @if (saved.Balance.StatementBalance is { } bank)
        { <p>@L["StatementBalance"]: @Money(bank).</p><p class="notice @(saved.Balance.Difference == 0 ? "success" : "warning")">@(saved.Balance.Difference == 0 ? L["BalanceMatches"].Value : L["BalanceDifference", Money(saved.Balance.Difference!.Value)].Value)</p> }
        else { <p class="notice warning">@L["NoBalanceComparison"]: @BalanceReason(saved.Balance.Status)</p> }
        <p class="muted">@L["BalanceCheckNote"]</p>
        <p>@L["InvalidFutureRows", saved.Balance.InvalidRowCount, saved.Balance.FutureRowCount]</p>
        <button class="primary" autofocus @onclick="OpenReview">@L[saved.Count > 0 ? "ContinueCheckCategories" : "ImportBackDashboard"]</button>
    </Modal>
}
@code {
    [SupplyParameterFromQuery(Name = "account")] public Guid? RequestedAccount { get; set; }
    private Guid? previousRequestedAccount;
    private Guid? uploadId, accountId; private string? fileName; private string worksheet = "", profileChoice = "";
    private IReadOnlyList<string> sheets = [], headers = [];
    private bool windows1252, settingsOpen, requiresMapping, commitConfirm, confirmCompletePeriod, exceptionsOnly, allowNavigation;
    private int step = 1;
    private static readonly string[] StepKeys = ["ImportStepFile", "ImportStepReview", "ImportStepSave"];
    private bool DatesValid => from == null && through == null || from != null && through != null && from <= through;
    private bool CanConfirmCoverage => confirmCompletePeriod && DatesValid && from <= State.Today && rows.All(r => r.AccountsForCoverage);
    private string PeriodSummary
    {
        get
        {
            if (from is { } start && through is { } end) return L["ImportSelectedPeriod", start.ToString("dd-MM-yyyy"), end.ToString("dd-MM-yyyy")];
            return firstObserved is { } first && lastObserved is { } last
                ? L["ImportObservedPeriod", first.ToString("dd-MM-yyyy"), last.ToString("dd-MM-yyyy")]
                : L["ImportNoObservedPeriod"];
        }
    }
    private bool OnlyExistingRows => rows.Count > 0 && rows.All(r => r.Source.IsValid && r.Source.DuplicateStatus == ImportDuplicateStatus.AlreadyImported);
    private string CommitQuestion => L["CommitImportQuestion", rows.Count(r => r.Include), State.AccountName(accountId)].Value +
        (rows.Count(r => r.Include && r.Source.DuplicateStatus != ImportDuplicateStatus.New) is > 0 and var overrides ? " " + L["ImportDuplicateOverride", overrides].Value : "");
    private void UnconfirmPartialCoverage() { if (rows.Any(r => !r.AccountsForCoverage)) confirmCompletePeriod = false; }
    private DateOnly? from, through, firstObserved, lastObserved; private ImportProfile? profile; private PreviewResponse? preview; private CommitImportResponse? result;
    private List<ImportReviewRow> rows = []; private int page, skippedCount, matchedSkippedCount;
    private readonly CancellationTokenSource cancellation = new();
    private static readonly (string Key, string Label)[] Columns = [
        (nameof(ImportProfile.DateColumn), "Date"), (nameof(ImportProfile.DescriptionColumn), "Description"), (nameof(ImportProfile.ExtraDescriptionColumn), "ExtraDescription"),
        (nameof(ImportProfile.AmountColumn), "SignedAmount"), (nameof(ImportProfile.DebitColumn), "DebitAlternative"), (nameof(ImportProfile.CreditColumn), "CreditAlternative"),
        (nameof(ImportProfile.DirectionColumn), "DebitCreditIndicator"), (nameof(ImportProfile.CurrencyColumn), "Currency"), (nameof(ImportProfile.AccountReferenceColumn), "OriginatingAccount"),
        (nameof(ImportProfile.BalanceColumn), "BalanceAfterEntry"), (nameof(ImportProfile.FallbackDescriptionColumn), "FallbackTransactionType")];
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (State.Data.Accounts.Count == 1) accountId = State.Data.Accounts[0].Id;
    }
    protected override void OnParametersSet()
    {
        if (RequestedAccount == previousRequestedAccount) return;
        previousRequestedAccount = RequestedAccount;
        accountId = State.Data.Accounts.Any(a => a.Id == RequestedAccount) ? RequestedAccount
            : State.Data.Accounts.Count == 1 ? State.Data.Accounts[0].Id : null;
        Invalidate();
    }
    private void Invalidate() { preview = null; rows.Clear(); commitConfirm = false; confirmCompletePeriod = false; step = 1; }
    private void BackToFile(bool options) { Invalidate(); settingsOpen = options; }
    private void ChangeSourceSettings()
    {
        headers = []; requiresMapping = false;
        UseProfile();
    }
    private void SelectValid() { foreach (var row in rows) row.Include = row.Source.IsValid && row.Source.DuplicateStatus == ImportDuplicateStatus.New; UnconfirmPartialCoverage(); }
    private void ClearSelection() { foreach (var row in rows) row.Include = false; UnconfirmPartialCoverage(); }
    private async Task BeforeNavigate(LocationChangingContext context)
    { if (!allowNavigation && !await JS.InvokeAsync<bool>("confirm", L["ImportLeaveWarning"].Value)) context.PreventNavigation(); }
    private async Task Upload(InputFileChangeEventArgs args)
    {
        ChangeSourceSettings(); uploadId = null; sheets = []; worksheet = ""; fileName = null;
        await State.RunAsync(async () =>
        {
            var file = args.File; fileName = file.Name;
            if (file.Size > 50L * 1024 * 1024) throw new InvalidDataException(L["ImportFileTooLarge"]);
            await using var stream = file.OpenReadStream(50L * 1024 * 1024, cancellation.Token);
            var response = await Backend.UploadAsync(stream, file.Name, cancellation.Token); uploadId = response.UploadId; sheets = response.Worksheets;
        }, L["FileReadyForPreview"]);
    }
    private void UseProfile()
    {
        var bank = profileChoice.StartsWith("bank:", StringComparison.Ordinal);
        var id = Guid.TryParse(bank ? profileChoice[5..] : profileChoice, out var parsed) ? parsed : (Guid?)null;
        profile = (bank ? BankImportProfiles.All : State.Data.ImportProfiles).FirstOrDefault(p => p.Id == id) is { } selected ? selected with { } : null;
        Invalidate();
    }
    private string ProfileValue(string key) => (string?)typeof(ImportProfile).GetProperty(key)!.GetValue(profile) ?? "";
    private void MapColumn(string key, string value) { typeof(ImportProfile).GetProperty(key)!.SetValue(profile, value); Invalidate(); }
    private async Task Preview()
    {
        if (uploadId == null || accountId == null || !DatesValid) return;
        Invalidate();
        requiresMapping = false;
        var read = await State.RunAsync(async () =>
        {
            var response = await Backend.PreviewAsync(new(uploadId.Value, accountId.Value, from ?? DateOnly.MinValue, through ?? DateOnly.MaxValue,
                profile, worksheet.Length == 0 ? null : worksheet, windows1252, AllowIncompleteMapping: true), State.Revision);
            profile = response.Profile with { }; headers = response.Headers; requiresMapping = response.RequiresMapping;
            if (requiresMapping) return;
            preview = response; rows = response.Rows.Select(r => new ImportReviewRow(r)).ToList();
            firstObserved = response.Rows.Min(r => r.Date); lastObserved = response.Rows.Max(r => r.Date);
            page = 0; exceptionsOnly = false; step = 2;
        });
        if (!read || requiresMapping) settingsOpen = true;
    }
    private async Task Adjust(ImportReviewRow row, ChangeEventArgs args)
    {
        if (preview == null) return;
        var id = Guid.TryParse(args.Value?.ToString(), out var parsed) ? parsed : (Guid?)null;
        await State.RunAsync(async () =>
        {
            var keep = row.Include;
            row.Source = await Backend.AdjustAsync(new(preview.PreviewId, row.Number, null, id, true));
            row.Include = row.Source.IsValid && keep;
        });
    }
    private async Task Commit()
    {
        if (preview == null) return;
        await State.RunAsync(async () =>
        {
            var selections = rows.Where(r => r.Include).Select(r => new ImportSelection(r.Number, r.Source.CategoryId, null, r.Source.DuplicateStatus != ImportDuplicateStatus.New)).ToArray();
            result = await Backend.CommitAsync(new(preview.PreviewId, selections, CanConfirmCoverage), preview.Revision);
            matchedSkippedCount = rows.Count(r => !r.Include && r.Source.DuplicateStatus == ImportDuplicateStatus.AlreadyImported);
            skippedCount = rows.Count - selections.Length - matchedSkippedCount; commitConfirm = false; preview = null; rows.Clear(); uploadId = null;
            if (!State.Scope.Contains(accountId!.Value)) State.OwnerId = null;
            await State.LoadAsync();
        }, L["ImportSaved"]);
    }
    private void OpenReview() { var saved = result; result = null; allowNavigation = true; Navigation.NavigateTo(saved is { Count: > 0 } ? $"categoriseren?batch={saved.BatchId:D}&inbox=true" : ""); }
    private string BalanceReason(StatementBalanceStatus status) => L[status switch { StatementBalanceStatus.Missing => "MissingStatementBalance", StatementBalanceStatus.Ambiguous => "AmbiguousStatementBalance", StatementBalanceStatus.InvalidRows => "InvalidBalanceRows", StatementBalanceStatus.NoActualRows => "NoActualBalanceRows", _ => "NoBankReference" }];
    public override void Dispose() { cancellation.Cancel(); cancellation.Dispose(); base.Dispose(); }
}
