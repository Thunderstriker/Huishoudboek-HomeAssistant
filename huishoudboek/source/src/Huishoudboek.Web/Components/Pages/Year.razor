@page "/jaar"
@attribute [Authorize]
@inherits PageBase
<PageTitle>Jaaroverzicht · Huishoudboek</PageTitle>
@{ var overview = DetailedReporting.Year(State.Data, State.Year, State.Today, State.OwnerId); var maximum = Math.Max(1, overview.Months.Max(r => Math.Max(r.Income, Math.Max(r.Outflow, Math.Abs(r.Savings))))); }
<h1>Jaaroverzicht @State.Year</h1>
<div class="metrics">
    <div class="card"><div class="metric-label">Inkomsten</div><div class="metric-value positive">@Money(overview.Income)</div></div>
    <div class="card"><div class="metric-label">Lasten</div><div class="metric-value">@Money(overview.Outflow)</div></div>
    <div class="card"><div class="metric-label">Opzijgezet</div><div class="metric-value">@Money(overview.Savings)</div></div>
    <div class="card"><div class="metric-label">Over</div><div class="metric-value">@Money(overview.Available)</div></div>
</div>
<section class="card"><h2>Werkelijke bedragen per maand</h2><div class="legend"><span>● Inkomsten</span><span>● Lasten</span><span>● Opzijgezet</span></div>
<div class="table-scroll"><div class="chart" role="img" aria-label="Maandbedragen; exacte waarden staan in de tabel hieronder">
    @foreach (var row in overview.Months)
    { <div class="chart-month"><div class="bars"><div class="bar" style="height:@Height(row.Income, maximum)px" title="@Money(row.Income)"></div><div class="bar outflow" style="height:@Height(row.Outflow, maximum)px" title="@Money(row.Outflow)"></div><div class="bar savings" style="height:@Height(Math.Abs(row.Savings), maximum)px" title="@Money(row.Savings)"></div></div><small>@MonthName(row.Month)</small></div> }
</div></div><p class="muted">Alleen boekingen t/m vandaag. Netto-opnamen hebben een absolute balkhoogte; de tabel toont het negatieve bedrag.</p>
<div class="table-scroll"><table><thead><tr><th>Maand</th><th class="money">Inkomsten</th><th class="money">Lasten</th><th class="money">Opzijgezet</th><th class="money">Over</th></tr></thead><tbody>
    @foreach (var row in overview.Months) { <tr><td>@MonthName(row.Month)</td><td class="money">@Money(row.Income)</td><td class="money">@Money(row.Outflow)</td><td class="money">@Money(row.Savings)</td><td class="money">@Money(row.Available)</td></tr> }
</tbody></table></div></section>
<section class="card"><h2>Jaaruitgaven per categorie</h2><div class="table-scroll"><table><thead><tr><th>Categorie</th><th class="money">Jaarbudget (12 maanden)</th><th class="money">Werkelijk uitgegeven</th></tr></thead><tbody>
    @foreach (var row in overview.Categories) { <tr><td>@row.Name</td><td class="money">@Money(row.Budget)</td><td class="money">@Money(row.Spent)</td></tr> }
</tbody></table></div></section>
@code {
    private static string MonthName(int month) => CultureInfo.GetCultureInfo("nl-NL").DateTimeFormat.GetAbbreviatedMonthName(month);
    private static string Height(decimal amount, decimal maximum) => (amount / maximum * 180).ToString("0.##", CultureInfo.InvariantCulture);
}
