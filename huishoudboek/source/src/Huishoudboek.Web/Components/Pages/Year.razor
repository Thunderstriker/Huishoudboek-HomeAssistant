@page "/jaar"
@attribute [Authorize]
@inherits PageBase
<PageTitle>@L["AnnualOverview"] · Huishoudboek</PageTitle>
@{
    var overview = DetailedReporting.Year(State.Data, State.Year, State.Today, State.OwnerId);
    var actualMonths = overview.Months.Where(m => State.Year < State.Today.Year || (State.Year == State.Today.Year && m.Month <= State.Today.Month)).ToList();
}
<h1>@L["AnnualOverview"] @State.Year</h1>
<div class="metrics">
    <div class="card"><div class="metric-label">@L["Income"]</div><div class="metric-value positive">@Money(overview.Income)</div></div>
    <div class="card"><div class="metric-label">@L["Outflow"]</div><div class="metric-value">@Money(overview.Outflow)</div></div>
    <div class="card"><div class="metric-label">@L["Savings"]</div><div class="metric-value">@Money(overview.Savings)</div></div>
    <div class="card"><div class="metric-label">@L["Available"]</div><div class="metric-value">@Money(overview.Available)</div></div>
</div>
<YearCharts Months="actualMonths" Categories="overview.Categories" />
<p class="muted">@L["AnnualActualNote"]</p>
<details class="card"><summary>@L["ViewMonthlyAmounts"]</summary>
<div class="table-scroll"><table><thead><tr><th>@L["Month"]</th><th class="money">@L["Income"]</th><th class="money">@L["Outflow"]</th><th class="money">@L["Savings"]</th><th class="money">@L["Available"]</th></tr></thead><tbody>
    @foreach (var row in overview.Months) { <tr><td>@MonthName(row.Month)</td><td class="money">@Money(row.Income)</td><td class="money">@Money(row.Outflow)</td><td class="money">@Money(row.Savings)</td><td class="money">@Money(row.Available)</td></tr> }
</tbody></table></div></details>
<details class="card"><summary>@L["ViewAnnualBudgets"]</summary>
<p class="muted">@L["AnnualBudgetNote"]</p>
<div class="table-scroll"><table><thead><tr><th>@L["Category"]</th><th class="money">@L["AnnualBudget"]</th><th class="money">@L["ActuallySpent"]</th></tr></thead><tbody>
    @foreach (var row in overview.Categories) { <tr><td>@State.CategoryName(row.Id)</td><td class="money">@Money(row.Budget)</td><td class="money">@Money(row.Spent)</td></tr> }
</tbody></table></div></details>
@code {
    private static string MonthName(int month) => UiCulture.Culture.DateTimeFormat.GetAbbreviatedMonthName(month);
}
