    }
    private async Task RequestParse() { if (items.Count > 0 || !string.IsNullOrWhiteSpace(draft?.Merchant) || draft?.Total != null) replaceTextConfirm = true; else await ApplyText(); }
    private async Task ApplyText() { await State.RunAsync(() => { ParseText(); replaceTextConfirm = false; return Task.CompletedTask; }); }
    private void ParseText()
    {
        if (draft == null) return;
        var parsed = ReceiptTextParser.Parse(sourceText);
        numbers.Clear();
        draft.Merchant = parsed.Receipt.Merchant; draft.PurchaseDate = parsed.Receipt.PurchaseDate; draft.Total = parsed.Receipt.Total; draft.InvoiceNumber = parsed.Receipt.InvoiceNumber;
        draft.MealVoucherAmount = parsed.Receipt.MealVoucherAmount;
        items = parsed.Items.Select(i => i with { ReceiptId = draft.Id }).ToList(); Unreview();
    }
    private void AddItem() { if (draft != null && items.Count < PurchaseReceipts.MaximumItems) items.Add(new() { ReceiptId = draft.Id, Position = items.Count }); Unreview(); }
    private void Remove(PurchaseReceiptItem item)
    {
        items.Remove(item);
        RemoveNumbers(item.Id);
        foreach (var discount in items.Where(i => i.RelatedItemId == item.Id)) discount.RelatedItemId = null;
        Unreview();
    }
    private void Move(PurchaseReceiptItem item, int direction)
    {
        var index = items.IndexOf(item); var target = index + direction;
        if (index >= 0 && target >= 0 && target < items.Count) (items[index], items[target]) = (items[target], items[index]);
        Unreview();
    }
    private async Task Merge(PurchaseReceiptItem item)
    {
        await State.RunAsync(() =>
        {
            if (HasInvalidNumbers) throw new InvalidOperationException(L["PurchaseInvalidNumbers"]);
            var index = items.IndexOf(item); if (index <= 0) return Task.CompletedTask;
            var previous = items[index - 1];
            if (previous.Kind != item.Kind || previous.CategoryId != item.CategoryId || item.RelatedItemId != null || previous.RelatedItemId != null ||
                new[] { item, previous }.Any(i => i.Model.Length > 0 || i.SerialNumber.Length > 0 || i.Location.Length > 0 || i.ReturnBy != null || i.WarrantyUntil != null || i.ReimbursementClaimId != null || i.Status != PurchaseItemStatus.Kept))
                throw new InvalidOperationException(L["PurchaseMergeUnsafe"]);
            if (previous.Name.Length + item.Name.Length + 1 > 300 || previous.OriginalDescription.Length + item.OriginalDescription.Length + 1 > 2000)
                throw new InvalidOperationException(L["PurchaseMergeTooLong"]);
            previous.Name += " " + item.Name; previous.OriginalDescription += "\n" + item.OriginalDescription;
            previous.Amount = previous.Amount != null && item.Amount != null ? previous.Amount + item.Amount : null;
            previous.Quantity = null; previous.UnitPrice = null; previous.Unit = "";
            RemoveNumbers(previous.Id); RemoveNumbers(item.Id);
            foreach (var discount in items.Where(i => i.RelatedItemId == item.Id)) discount.RelatedItemId = previous.Id;
            items.Remove(item); Unreview(); return Task.CompletedTask;
        });
    }
    private void KindChanged(PurchaseReceiptItem item)
    {
        if (item.Kind != ReceiptLineKind.Discount) item.RelatedItemId = null;
        if (item.Kind != ReceiptLineKind.Product) foreach (var discount in items.Where(i => i.RelatedItemId == item.Id)) discount.RelatedItemId = null;
        Unreview();
    }
    private void DiscountChanged(PurchaseReceiptItem item) { if (item.RelatedItemId != null) item.CategoryId = null; Unreview(); }
    private Guid? CategoryFor(PurchaseReceiptItem item) => draft == null ? item.CategoryId : PurchaseReceipts.CategoryFor(draft, item, items);
    private void Unreview() { if (draft != null) draft.IsReviewed = false; }
    private void AccountChanged() { if (draft != null) { draft.TransactionId = null; foreach (var item in items) item.ReimbursementClaimId = null; Unreview(); } }
    private void TransactionChanged()
    {
        if (draft == null) return;
        if (LinkedTransaction is { } linked) draft.AccountId = linked.AccountId;
        foreach (var item in items) item.ReimbursementClaimId = null;
        Unreview();
    }
    private void LinkTransaction(Transaction transaction) { if (draft != null) { draft.TransactionId = transaction.Id; TransactionChanged(); } }
    private void NewVoucherCredit(bool opening) => voucherCredit = new()
    { Date = draft?.PurchaseDate ?? State.Today, IsOpeningBalance = opening };
    private async Task SaveVoucherCredit()
    {
        if (draft is not { } receipt || voucherCredit is not { } credit) return;
        var savedCredit = credit with { };
        var revision = draftRevision;
        await State.RunAsync(async () =>
        {
            await State.SaveAsync(d => MealVouchers.SaveCredit(d, savedCredit), revision);
            // Only our own successful credit save may advance the unsaved purchase's revision.
            if (ReferenceEquals(draft, receipt))
            { draftRevision = State.Revision; voucherCredit = null; }
        }, L["PurchaseVoucherCreditSaved"]);
    }
    private async Task Save()
    {
        if (draft == null || voucherCredit != null) return;
        await State.RunAsync(async () =>
        {
            if (HasInvalidNumbers) throw new InvalidOperationException(L["PurchaseInvalidNumbers"]);
            await Receipts.SaveAsync(draftRevision, draft, items, keepDocument, scan?.UploadId, cancellation.Token);
            await CloseDraft(); await State.LoadAsync();
        }, L["PurchaseSavedMessage"]);
    }
    private async Task Delete(Guid id)
    {
        await State.RunAsync(async () => { await State.SaveAsync(d => PurchaseReceipts.Delete(d, id)); deleteId = null; }, L["PurchaseDeleted"]);
    }
    private bool DueSoon(DateOnly? date) => date is { } value && value >= State.Today && value <= State.Today.AddDays(30);
    private DateOnly EarliestDue(PurchaseReceiptItem item) => new[] { item.ReturnBy, item.WarrantyUntil }.Where(DueSoon).Min() ?? DateOnly.MaxValue;
    private async Task CloseDraft()
    {
        if (scan != null) Receipts.DiscardUpload(scan.UploadId);
        scan = null; draft = null; voucherCredit = null; items = []; numbers.Clear(); sourceText = ""; bankSearch = ""; replaceTextConfirm = false;
        await ReleasePreview();
    }
    private async Task ReleasePreview()
    {
        if (previewUrl != null && module != null)
            try { await module.InvokeVoidAsync("release", previewUrl); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException) { }
        previewUrl = null;
    }
    private async Task BeforeNavigate(LocationChangingContext context)
    {
        if (draft != null && !allowNavigation && !await JS.InvokeAsync<bool>("confirm", L["PurchaseLeaveWarning"].Value)) context.PreventNavigation();
        else allowNavigation = true;
    }
    protected override void OnStateChanged()
    {
        // Do not discard an unsaved draft or leave it presented under another owner's context.
        if (draft != null && ownerAtEdit != State.OwnerId)
        { State.OwnerId = ownerAtEdit; ownerChangeBlocked = true; State.Notify(); }
    }
    public override void Dispose() => _ = DisposeAsync();
    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true; base.Dispose(); cancellation.Cancel();
        if (scan != null) Receipts.DiscardUpload(scan.UploadId);
        await ReleasePreview();
        if (module != null)
            try { await module.DisposeAsync(); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException) { }
        cancellation.Dispose();
    }
