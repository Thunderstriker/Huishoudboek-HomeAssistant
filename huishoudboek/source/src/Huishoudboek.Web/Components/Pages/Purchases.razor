@page "/aankopen"
@attribute [Authorize]
@inherits PageBase
@implements IAsyncDisposable
@inject IReceiptAdministration Receipts
@inject IJSRuntime JS

<PageTitle>@L["PurchasesTitle"] · Huishoudboek</PageTitle>
<h1>@L["PurchasesTitle"]</h1>
<p class="muted">@L["PurchasesHelp"]</p>
<div class="actions"><button class="primary" @onclick="NewReceipt" disabled="@(draft != null)">+ @L["PurchaseNew"]</button><a class="button" href="maaltijdcheques">@L["MealVouchersTitle"]: @Money(MealVouchers.Balance(State.Data, State.Today))</a></div>
@if (InitialTransaction != null) { <p><a href="aankopen">@L["PurchaseViewAll"]</a></p> }

@if (draft is { } receipt)
{
    var totalInput = Number(receipt.Id, nameof(receipt.Total), receipt.Total, minimum: 0);
    var voucherInput = Number(receipt.Id, nameof(receipt.MealVoucherAmount), receipt.MealVoucherAmount, minimum: 0, emptyAsZero: true);
    var itemInputs = items.ToDictionary(i => i.Id, i => (
        Quantity: Number(i.Id, nameof(i.Quantity), i.Quantity, decimalPlaces: 4, minimum: .0001m, maximum: 1_000_000m),
        Price: Number(i.Id, nameof(i.UnitPrice), i.UnitPrice, decimalPlaces: 4, minimum: 0),
        Amount: Number(i.Id, nameof(i.Amount), i.Amount)));
    var hasInvalidNumbers = HasInvalidNumbers;
    <NavigationLock ConfirmExternalNavigation="true" OnBeforeInternalNavigation="BeforeNavigate" />
    <section class="card receipt-editor" aria-labelledby="receipt-editor-title">
        <div class="page-heading"><h2 id="receipt-editor-title">@L["PurchaseReview"]</h2><button @onclick="CloseDraft">@L["Cancel"]</button></div>
        <p class="notice">@L["PurchaseNoAccounting"]</p>
        @if (ownerChangeBlocked) { <p class="notice warning">@L["PurchaseFinishEditing"]</p> }
        @if (draftRevision != State.Revision) { <p class="notice warning">@L["PurchaseStaleDraft"]</p> }
        <div class="receipt-workspace">
            <aside class="receipt-source">
                <label for="receipt-upload">@L["PurchaseUpload"]</label>
                <InputFile id="receipt-upload" OnChange="Upload" accept="image/jpeg,image/png,application/pdf,.jpg,.jpeg,.png,.pdf" />
                <p class="muted">@L["PurchaseUploadHelp"]</p>
                @if (State.Busy) { <p role="status">@L["PurchaseRecognizing"]</p> }
                @if (scan != null)
                {
                    <p class="notice @(scan.State == ReceiptRecognitionState.Recognized ? "" : "warning")">@L[$"PurchaseRecognition{scan.State}"]</p>
                    <p>@scan.FileName</p>
                    @if (previewUrl != null && scan.ContentType.StartsWith("image/", StringComparison.Ordinal))
                    { <img class="receipt-preview" src="@previewUrl" alt="@L["PurchasePreviewAlt"]" /> }
                    @if (previewUrl != null)
                    { <a href="@previewUrl" download="@scan.FileName">@L["PurchaseOpenUpload"]</a> }
                }
                @if (receipt.DocumentName.Length > 0)
                { <p><a href="@DocumentUrl(receipt.Id)" data-enhance-nav="false">@L["PurchaseDownload"]: @receipt.DocumentName</a></p> }
                <label class="check"><input id="receipt-keep" type="checkbox" @bind="keepDocument" />@L["PurchaseKeepDocument"]</label>
                <p class="muted">@L[keepDocument ? "PurchaseKeepHelp" : "PurchaseDiscardHelp"]</p>
                @if (!keepDocument && receipt.DocumentName.Length > 0)
                { <p class="notice warning">@L["PurchaseRemoveDocumentWarning"]</p> }
                <details>
                    <summary>@L["PurchaseSourceText"]</summary>
                    <p class="muted">@L["PurchaseSourceTextHelp"]</p>
                    <textarea id="receipt-text" rows="12" maxlength="128000" @bind="sourceText" aria-label="@L["PurchaseSourceText"]"></textarea>
                    <button @onclick="RequestParse" disabled="@(string.IsNullOrWhiteSpace(sourceText))">@L["PurchaseParseText"]</button>
                </details>
            </aside>
            <div class="receipt-fields">
                <div class="fields">
                    <label>@L["PurchaseMerchant"]<input id="receipt-merchant" maxlength="200" @bind="receipt.Merchant" @bind:after="Unreview" /></label>
                    <label>@L["PurchaseDate"]<input id="receipt-date" type="date" @bind="receipt.PurchaseDate" @bind:after="Unreview" /></label>
                    <label>@L["PurchaseInvoice"]<input maxlength="200" @bind="receipt.InvoiceNumber" @bind:after="Unreview" /></label>
                    <label>@L["PurchaseTotal"]<input id="receipt-total" type="text" inputmode="decimal" @bind="totalInput.Text" @bind:event="oninput" @bind:after="() => { receipt.Total = totalInput.Value; Unreview(); }" aria-invalid="@(!totalInput.IsValid ? "true" : null)" /></label>
                    <label>@L["PurchaseDefaultCategory"]<select id="receipt-default-category" @bind="receipt.DefaultCategoryId" @bind:after="Unreview"><option value="">@L["Uncategorized"]</option>@foreach (var category in ExpenseCategories) { <option value="@category.Id">@State.CategoryName(category.Id)</option> }</select></label>
                    <label>@L["Account"]<select @bind="receipt.AccountId" @bind:after="AccountChanged"><option value="">@L["PurchaseNoAccount"]</option>@foreach (var account in State.Data.Accounts.Where(a => State.Scope.Contains(a.Id))) { <option value="@account.Id">@account.Name</option> }</select></label>
                    <label>@L["PurchaseNotes"]<textarea rows="2" maxlength="4000" @bind="receipt.Notes"></textarea></label>
                </div>
                <p class="muted">@L["PurchaseDefaultCategoryHelp"]</p>
                <div class="receipt-payments">
                    <label>@L["PurchaseMealVouchers"]<input id="receipt-meal-vouchers" type="text" inputmode="decimal" @bind="voucherInput.Text" @bind:event="oninput" @bind:after="() => { receipt.MealVoucherAmount = voucherInput.Value ?? 0; Unreview(); }" aria-invalid="@(!voucherInput.IsValid ? "true" : null)" /></label>
                    <p class="muted">@L["PurchaseMealVouchersHelp"]</p>
                    @if (receipt.MealVoucherAmount > 0)
                    {
                        <p>@L["MealVouchersAvailableForReceipt"]: @Money(VoucherAvailable) · <a href="maaltijdcheques" target="_blank" rel="noopener">@L["MealVouchersTitle"] →</a></p>
                        @if (receipt.MealVoucherAmount > VoucherAvailable) { <p class="notice warning">@L["MealVouchersNegative"]</p> }
                    }
                    <div class="actions">
                        <button type="button" @onclick="() => NewVoucherCredit(false)" disabled="@(voucherCredit != null || State.Busy)">+ @L["MealVouchersAdd"]</button>
                        @if (!State.Data.MealVoucherCredits.Any(c => c.IsOpeningBalance))
                        { <button type="button" @onclick="() => NewVoucherCredit(true)" disabled="@(voucherCredit != null || State.Busy)">@L["MealVouchersOpening"]</button> }
                    </div>
                    @if (voucherCredit is { } credit)
                    {
                        <section class="receipt-voucher-credit" aria-labelledby="receipt-voucher-title">
                            <h3 id="receipt-voucher-title">@L[credit.IsOpeningBalance ? "MealVouchersOpening" : "MealVouchersAdd"]</h3>
                            <p class="notice">@L["PurchaseVoucherCreditHelp"]</p>
                            <MealVoucherCreditForm Credit="credit" Busy="State.Busy" OnSave="SaveVoucherCredit" OnCancel="() => voucherCredit = null" />
                        </section>
                    }
                    <strong>@L["PurchaseAmountDue"]: @(!hasInvalidNumbers && PurchaseReceipts.AmountDue(receipt) is { } due ? Money(due) : L["Unknown"].Value)</strong>
                    @if (!PurchaseReceipts.HasValidMealVoucherAmount(receipt))
                    { <p class="notice warning" role="alert">@L["PurchaseInvalidMealVouchers"]</p> }
                </div>
                <details open="@(receipt.TransactionId != null)">
                    <summary>@L["PurchaseBankLink"]</summary>
                    <p class="muted">@L["PurchaseBankLinkHelp"]</p>
                    <label>@L["Search"]<input type="search" @bind="bankSearch" @bind:event="oninput" /></label>
                    <label>@L["BankEntry"]<select @bind="receipt.TransactionId" @bind:after="TransactionChanged"><option value="">@L["PurchaseNoTransaction"]</option>@foreach (var entry in BankChoices) { <option value="@entry.Id">@BankLabel(entry)</option> }</select></label>
                    @foreach (var entry in BankSuggestions)
                    { <p><button @onclick="() => LinkTransaction(entry)">@L["PurchaseLinkSuggestion"]: @BankLabel(entry)</button></p> }
                    @if (!hasInvalidNumbers && LinkedTransaction is { } linked && PurchaseReceipts.AmountDue(receipt) is { } amountDue && -linked.Amount != amountDue)
                    { <p class="notice warning">@L["PurchaseBankMismatch", Money(-linked.Amount), Money(amountDue)]</p> }
                </details>
                <div class="receipt-reconciliation notice @(IsReconciled ? "success" : "warning")" role="status">
                    @if (hasInvalidNumbers)
                    { <strong role="alert">@L["PurchaseInvalidNumbers"]</strong> }
                    else
                    {
                        <strong>@L["PurchaseItemTotal"]: @Money(PurchaseReceipts.ItemTotal(items))</strong>
                        <span>@L["PurchaseTotal"]: @(receipt.Total is { } value ? Money(value) : L["Unknown"].Value)</span>
                        @if (receipt.Total is { } expected) { <span>@L["PurchaseDifference"]: @Money(expected - PurchaseReceipts.ItemTotal(items))</span> }
                        <small>@L[IsReconciled ? "PurchaseReconciled" : "PurchaseNeedsReview"]</small>
                    }
                </div>
            </div>
        </div>

        <div class="page-heading"><h3>@L["PurchaseItems"] (@items.Count)</h3><button @onclick="AddItem" disabled="@(items.Count >= PurchaseReceipts.MaximumItems)">+ @L["PurchaseAddItem"]</button></div>
        <p class="muted">@L["PurchaseCategoriesHelp"]</p>
        @foreach (var item in items)
        {
            var (quantityInput, priceInput, amountInput) = itemInputs[item.Id];
            <article class="receipt-line" data-item-id="@item.Id" @key="item.Id">
                <div class="receipt-item-grid">
                    <label class="receipt-item-name">@L["PurchaseItemName"]<input maxlength="300" @bind="item.Name" @bind:after="Unreview" /></label>
                    <label>@L["PurchaseQuantity"]<input type="text" inputmode="decimal" @bind="quantityInput.Text" @bind:event="oninput" @bind:after="() => { item.Quantity = quantityInput.Value; Unreview(); }" aria-invalid="@(!quantityInput.IsValid ? "true" : null)" /></label>
                    <label>@L["PurchaseUnit"]<input maxlength="30" @bind="item.Unit" @bind:after="Unreview" /></label>
                    <label>@L["PurchaseUnitPrice"]<input type="text" inputmode="decimal" @bind="priceInput.Text" @bind:event="oninput" @bind:after="() => { item.UnitPrice = priceInput.Value; Unreview(); }" aria-invalid="@(!priceInput.IsValid ? "true" : null)" /></label>
                    <label>@L["PurchaseLineAmount"]<input type="text" inputmode="decimal" @bind="amountInput.Text" @bind:event="oninput" @bind:after="() => { item.Amount = amountInput.Value; Unreview(); }" aria-invalid="@(!amountInput.IsValid ? "true" : null)" /></label>
                    <label>@L["Category"]<select @bind="item.CategoryId" @bind:after="Unreview" disabled="@(item.RelatedItemId != null)"><option value="">@(item.RelatedItemId != null ? L["PurchaseInheritCategory"].Value : receipt.DefaultCategoryId != null ? L["PurchaseUseDefaultCategory", State.CategoryName(receipt.DefaultCategoryId)].Value : L["Uncategorized"].Value)</option>@foreach (var category in ExpenseCategories) { <option value="@category.Id">@State.CategoryName(category.Id)</option> }</select></label>
                </div>
                <details>
                    <summary>@L["PurchaseItemDetails"]</summary>
                    @if (item.OriginalDescription.Length > 0) { <p class="receipt-original"><strong>@L["PurchaseOriginalText"]:</strong> @item.OriginalDescription</p> }
                    <div class="fields">
                        <label>@L["PurchaseLineKind"]<select @bind="item.Kind" @bind:after="() => KindChanged(item)">@foreach (var kind in Enum.GetValues<ReceiptLineKind>()) { <option value="@kind">@L[$"PurchaseKind{kind}"]</option> }</select></label>
                        @if (item.Kind == ReceiptLineKind.Discount)
                        { <label>@L["PurchaseDiscountFor"]<select @bind="item.RelatedItemId" @bind:after="() => DiscountChanged(item)"><option value="">@L["PurchaseWholeReceiptDiscount"]</option>@foreach (var product in items.Where(i => i.Kind == ReceiptLineKind.Product)) { <option value="@product.Id">@product.Name</option> }</select></label> }
                        <label>@L["PurchaseModel"]<input maxlength="200" @bind="item.Model" /></label>
                        <label>@L["PurchaseSerial"]<input maxlength="200" @bind="item.SerialNumber" /></label>
                        <label>@L["PurchaseLocation"]<input maxlength="200" @bind="item.Location" /></label>
                        <label>@L["PurchaseReturnBy"]<input type="date" @bind="item.ReturnBy" @bind:after="Unreview" /></label>
                        <label>@L["PurchaseWarrantyUntil"]<input type="date" @bind="item.WarrantyUntil" @bind:after="Unreview" /></label>
                        <label>@L["Status"]<select @bind="item.Status">@foreach (var status in Enum.GetValues<PurchaseItemStatus>()) { <option value="@status">@L[$"PurchaseStatus{status}"]</option> }</select></label>
                        @if (receipt.TransactionId != null)
                        { <label>@L["PurchaseRefundExpectation"]<select @bind="item.ReimbursementClaimId"><option value="">@L["PurchaseNoExpectation"]</option>@foreach (var claim in State.Data.ReimbursementClaims.Where(c => c.ExpenseTransactionId == receipt.TransactionId)) { <option value="@claim.Id">@claim.Counterparty · @Money(claim.ExpectedAmount)</option> }</select></label> }
                    </div>
                    <p class="muted">@L["PurchaseDatesHelp"]</p>
                </details>
                <div class="actions receipt-line-actions">
                    <button @onclick="() => Move(item, -1)" disabled="@(items.IndexOf(item) == 0)" aria-label="@L["PurchaseMoveUp"]">↑</button>
                    <button @onclick="() => Move(item, 1)" disabled="@(items.IndexOf(item) == items.Count - 1)" aria-label="@L["PurchaseMoveDown"]">↓</button>
                    <button @onclick="() => Merge(item)" disabled="@(items.IndexOf(item) == 0 || hasInvalidNumbers)">@L["PurchaseMerge"]</button>
                    <button @onclick="() => Remove(item)">@L["Delete"]</button>
                </div>
            </article>
        }
        @if (items.Count == 0) { <p class="empty">@L["PurchaseNoItems"]</p> }
        @if (items.Count > 0 && !hasInvalidNumbers)
        {
            <details><summary>@L["PurchaseCategoryPreview"]</summary><p class="muted">@L["PurchaseCategoriesHelp"]</p><ul>@foreach (var group in items.GroupBy(CategoryFor)) { <li>@State.CategoryName(group.Key): @Money(group.Sum(i => i.Amount ?? 0))</li> }</ul></details>
        }
        <label class="check"><input id="receipt-reviewed" type="checkbox" @bind="receipt.IsReviewed" disabled="@(!IsReconciled || string.IsNullOrWhiteSpace(receipt.Merchant) || receipt.PurchaseDate == null)" />@L["PurchaseConfirmReview"]</label>
        <label class="check"><input id="receipt-applied" type="checkbox" @bind="receipt.IsApplied" disabled="@(!receipt.IsReviewed && !receipt.IsApplied)" />@L["PurchaseApplyReports"]</label>
        <p class="muted">@L["PurchaseApplyReportsHelp"]</p>
        @if (State.OwnerId != null) { <p class="muted">@L["MealVouchersSharedHelp"]</p> }
        <div class="actions receipt-save"><button class="primary" @onclick="Save" disabled="@(hasInvalidNumbers || voucherCredit != null || State.Busy)">@L[receipt.IsReviewed ? "PurchaseSaveReviewed" : "PurchaseSaveDraft"]</button><button @onclick="CloseDraft" disabled="@State.Busy">@L["Cancel"]</button></div>
    </section>
}

@if (replaceTextConfirm)
{ <Confirm Title="@L["PurchaseReplaceTitle"]" Text="@L["PurchaseReplaceText"]" ActionLabel="@L["PurchaseParseText"]" Cancel="() => replaceTextConfirm = false" Accept="ApplyText" /> }
@if (deleteId is { } deleting)
{ <Confirm Title="@L["PurchaseDelete"]" Text="@L["PurchaseDeleteHelp"]" ActionLabel="@L["Delete"]" Cancel="() => deleteId = null" Accept="() => Delete(deleting)" /> }

@{ var visible = VisibleReceipts.ToList(); var visibleIds = visible.Select(r => r.Id).ToHashSet(); var attention = State.Data.PurchaseReceiptItems.Where(i => visibleIds.Contains(i.ReceiptId) && i.Status == PurchaseItemStatus.Kept && (DueSoon(i.ReturnBy) || DueSoon(i.WarrantyUntil))).OrderBy(i => EarliestDue(i)).ToList(); }
@if (attention.Count > 0)
{
    <section class="card"><h2>@L["PurchaseDeadlines"]</h2><p class="muted">@L["PurchaseDeadlinesHelp"]</p><ul>
    @foreach (var item in attention.Take(20))
    { <li><button @onclick="() => Edit(State.Data.PurchaseReceipts.Single(r => r.Id == item.ReceiptId))" disabled="@(draft != null)">@item.Name</button> @if (DueSoon(item.ReturnBy)) { <span>@L["PurchaseReturnBy"]: @item.ReturnBy?.ToString("dd-MM-yyyy")</span> } @if (DueSoon(item.WarrantyUntil)) { <span> · @L["PurchaseWarrantyUntil"]: @item.WarrantyUntil?.ToString("dd-MM-yyyy")</span> }</li> }
    </ul></section>
}
<section class="card">
    <div class="page-heading"><h2>@L["PurchaseSaved"]</h2><span>@visible.Count</span></div>
    <label>@L["Search"]<input type="search" placeholder="@L["PurchaseSearchHint"]" @bind="search" @bind:event="oninput" @bind:after="() => page = 0" /></label>
    <p class="muted">@L["PurchasePeriodHelp"]</p>
    @{ page = Math.Min(page, Math.Max(0, (visible.Count - 1) / 20)); }
    @foreach (var saved in visible.Skip(page * 20).Take(20))
    {
        var savedItems = State.Data.PurchaseReceiptItems.Where(i => i.ReceiptId == saved.Id).OrderBy(i => i.Position).ToList();
        <details class="purchase-summary" @key="saved.Id">
            <summary><strong>@(saved.Merchant.Length > 0 ? saved.Merchant : L["PurchaseUnnamed"].Value)</strong><span>@saved.PurchaseDate?.ToString("dd-MM-yyyy")</span><strong>@(saved.Total is { } total ? Money(total) : "—")</strong><span class="badge">@L[saved.IsReviewed ? "PurchaseReviewed" : "PurchaseDraft"]</span><span class="badge">@L[saved.DocumentName.Length > 0 ? "PurchaseDocumentStored" : "PurchaseDataOnly"]</span></summary>
            <p>@State.AccountName(saved.AccountId) · @L["PurchaseItems"]: @savedItems.Count</p>
            @if (saved.MealVoucherAmount > 0) { <p>@L["PurchaseMealVouchers"]: @Money(saved.MealVoucherAmount) · @L["PurchaseAmountDue"]: @(PurchaseReceipts.AmountDue(saved) is { } savedDue ? Money(savedDue) : L["Unknown"].Value)</p> }
            @if (saved.IsApplied) { <p class="badge positive">@L["PurchaseApplied"]</p> }
            @if (saved.Notes.Length > 0) { <p>@saved.Notes</p> }
            <ul>@foreach (var item in savedItems) { <li>@item.Name · @(item.Amount is { } amount ? Money(amount) : "—") · @State.CategoryName(PurchaseReceipts.CategoryFor(saved, item, savedItems)) @if (item.Model.Length > 0) { <span> · @item.Model</span> } @if (item.SerialNumber.Length > 0) { <span> · @L["PurchaseSerial"]: @item.SerialNumber</span> } @if (item.ReturnBy != null) { <span> · @L["PurchaseReturnBy"]: @item.ReturnBy?.ToString("dd-MM-yyyy")</span> } @if (item.WarrantyUntil != null) { <span> · @L["PurchaseWarrantyUntil"]: @item.WarrantyUntil?.ToString("dd-MM-yyyy")</span> } @if (item.Status != PurchaseItemStatus.Kept) { <span class="badge">@L[$"PurchaseStatus{item.Status}"]</span> }</li> }</ul>
            <div class="actions"><button @onclick="() => Edit(saved)" disabled="@(draft != null)">@L["Edit"]</button>@if (saved.DocumentName.Length > 0) { <a class="button" href="@DocumentUrl(saved.Id)" data-enhance-nav="false">@L["PurchaseDownload"]</a> }<button @onclick="() => deleteId = saved.Id" disabled="@(draft != null)">@L["Delete"]</button></div>
        </details>
    }
    @if (visible.Count == 0) { <p class="empty">@L["PurchaseEmpty"]</p> }
    <Pager Count="visible.Count" Size="20" @bind-Page="page" />
</section>

@code {
    [SupplyParameterFromQuery(Name = "transaction")] public Guid? InitialTransaction { get; set; }
    [SupplyParameterFromQuery(Name = "receipt")] public Guid? InitialReceipt { get; set; }
    private PurchaseReceipt? draft;
    private MealVoucherCredit? voucherCredit;
    private List<PurchaseReceiptItem> items = [];
    private readonly Dictionary<(Guid Id, string Field), ReceiptNumberDraft> numbers = [];
    private string draftRevision = "", search = "", bankSearch = "", sourceText = "";
    private bool keepDocument, replaceTextConfirm, allowNavigation, ownerChangeBlocked;
    private Guid? deleteId, ownerAtEdit;
    private int page;
    private ReceiptScan? scan;
    private string? previewUrl;
    private IJSObjectReference? module;
    private readonly CancellationTokenSource cancellation = new();
    private bool disposed;

    private IEnumerable<Category> ExpenseCategories => CategoryHierarchy.Ordered(State.Data).Select(e => e.Category).Where(c => c.Purpose == CategoryPurpose.Normal);
    private bool HasInvalidNumbers => numbers.Values.Any(n => !n.IsValid);
    private bool IsReconciled => !HasInvalidNumbers && draft != null && PurchaseReceipts.Reconciles(draft, items);
    private ReceiptNumberDraft Number(Guid id, string field, decimal? value, int decimalPlaces = 2,
        decimal minimum = -1_000_000_000m, decimal maximum = 1_000_000_000m, bool emptyAsZero = false)
    {
        if (!numbers.TryGetValue((id, field), out var input))
            numbers[(id, field)] = input = new(value, UiCulture.Culture, decimalPlaces, minimum, maximum, emptyAsZero);
        return input;
    }
    private void RemoveNumbers(Guid id)
    {
        foreach (var key in numbers.Keys.Where(k => k.Id == id).ToList()) numbers.Remove(key);
    }
    private decimal VoucherAvailable
    {
        get
        {
            var date = draft?.PurchaseDate ?? State.Today;
            var previous = State.Data.PurchaseReceipts.FirstOrDefault(r => r.Id == draft?.Id && r.IsApplied && r.PurchaseDate <= date);
            return MealVouchers.Balance(State.Data, date) + (previous?.MealVoucherAmount ?? 0);
        }
    }
    private Transaction? LinkedTransaction => State.Data.Transactions.FirstOrDefault(t => t.Id == draft?.TransactionId);
    private static string DocumentUrl(Guid id) => $"website/receipts/{id:D}/document";
    private string BankLabel(Transaction entry) => $"{entry.Date:dd-MM-yyyy} · {State.AccountName(entry.AccountId)} · {TransactionRecognition.DisplayName(State.Data, entry)} · {Money(entry.Amount)}";
    private IEnumerable<Transaction> EligibleTransactions => State.Data.Transactions.Where(t => t.Kind == TransactionKind.Normal && t.Amount < 0 && State.Scope.Contains(t.AccountId) && (draft?.AccountId == null || t.AccountId == draft.AccountId));
    private IEnumerable<Transaction> BankChoices => ReceiptBankSearch.Find(EligibleTransactions, bankSearch, draft?.TransactionId);
    private IEnumerable<Transaction> BankSuggestions => !HasInvalidNumbers && draft is { } receipt && PurchaseReceipts.HasValidMealVoucherAmount(receipt) && PurchaseReceipts.AmountDue(receipt) is { } due && due > 0 && receipt.PurchaseDate is { } date && receipt.TransactionId == null
        ? EligibleTransactions.Where(t => -t.Amount == due && Math.Abs(t.Date.DayNumber - date.DayNumber) <= 7).OrderBy(t => Math.Abs(t.Date.DayNumber - date.DayNumber)).Take(3) : [];
    private IEnumerable<PurchaseReceipt> VisibleReceipts => State.Data.PurchaseReceipts.Where(r => (InitialTransaction == null || r.TransactionId == InitialTransaction) && (State.OwnerId == null || r.AccountId is { } account && State.Scope.Contains(account)) &&
        (string.IsNullOrWhiteSpace(search) || $"{r.Merchant} {r.InvoiceNumber} {r.Notes} {r.PurchaseDate:dd-MM-yyyy} {string.Join(' ', State.Data.PurchaseReceiptItems.Where(i => i.ReceiptId == r.Id).Select(i => $"{i.Name} {i.OriginalDescription} {i.Model} {i.SerialNumber} {i.Location} {State.CategoryName(PurchaseReceipts.CategoryFor(r, i, State.Data.PurchaseReceiptItems))}"))}".Contains(search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(r => r.PurchaseDate).ThenBy(r => r.Id);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (InitialReceipt is { } receiptId && State.Data.PurchaseReceipts.FirstOrDefault(r => r.Id == receiptId &&
            (State.OwnerId == null || r.AccountId is { } accountId && State.Scope.Contains(accountId))) is { } receipt) Edit(receipt);
        else if (InitialTransaction is { } id && State.Data.Transactions.Any(t => t.Id == id && State.Scope.Contains(t.AccountId)) && !State.Data.PurchaseReceipts.Any(r => r.TransactionId == id)) NewReceipt();
    }
    private void NewReceipt()
    {
        numbers.Clear();
        draft = new() { AccountId = State.OwnerId != null ? State.Data.Accounts.FirstOrDefault(a => State.Scope.Contains(a.Id))?.Id : null };
        items = []; draftRevision = State.Revision; ownerAtEdit = State.OwnerId; keepDocument = false; allowNavigation = false; ownerChangeBlocked = false;
        if (InitialTransaction is { } id && State.Data.Transactions.FirstOrDefault(t => t.Id == id && t.Kind == TransactionKind.Normal && t.Amount < 0 && State.Scope.Contains(t.AccountId)) is { } transaction)
            LinkTransaction(transaction);
    }
    private void Edit(PurchaseReceipt receipt)
    {
        numbers.Clear();
        draft = receipt with { }; items = State.Data.PurchaseReceiptItems.Where(i => i.ReceiptId == receipt.Id).OrderBy(i => i.Position).Select(i => i with { }).ToList();
        draftRevision = State.Revision; ownerAtEdit = State.OwnerId; keepDocument = receipt.DocumentName.Length > 0; allowNavigation = false; ownerChangeBlocked = false;
    }
    private async Task Upload(InputFileChangeEventArgs args)
    {
        await State.RunAsync(async () =>
        {
            if (scan != null) Receipts.DiscardUpload(scan.UploadId);
            scan = null;
            await ReleasePreview();
            var file = args.File;
            if (file.Size > PurchaseReceipts.MaximumDocumentBytes) throw new InvalidDataException(L["PurchaseTooLarge"]);
            await using var stream = file.OpenReadStream(PurchaseReceipts.MaximumDocumentBytes, cancellation.Token);
            scan = await Receipts.RecognizeAsync(stream, file.Name, cancellation.Token);
            if (disposed) { Receipts.DiscardUpload(scan.UploadId); return; }
            try
            {
                module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Huishoudboek.Web/purchase-receipts.js");
                previewUrl = await module.InvokeAsync<string?>("preview", "receipt-upload");
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
            { /* Recognition/review works without a browser preview. */ }
            sourceText = scan.Text;
            if (items.Count == 0 && string.IsNullOrWhiteSpace(draft?.Merchant) && draft?.Total == null) ParseText();
            else if (sourceText.Length > 0) replaceTextConfirm = true;
