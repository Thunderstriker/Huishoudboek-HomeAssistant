@page "/weekcontrole"
@attribute [Authorize]
@inherits PageBase
<PageTitle>@L["WeeklyReviewTitle"] · Huishoudboek</PageTitle>
<div class="page-heading"><div><h1>@L["ReviewTasks"]</h1><p class="muted">@L["WeeklyReviewTitle"] · @State.Today.ToString("dd-MM-yyyy")</p></div><a class="button" href="">@L["StartDashboard"]</a></div>
@if (State.Data.Accounts.Count == 0)
{
    <p><a class="button primary" href="instellen">@L["GetStarted"]</a></p>
}
else
{
    <WeeklyReview />
}
<ContractAttentionList />
<section class="card">
    <h2>@L["NavigationPreferences"]</h2>
    <WeeklyReviewVisibility />
</section>
