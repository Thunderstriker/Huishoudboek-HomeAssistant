@page "/kalender"
@attribute [Authorize]
@inherits PageBase
<PageTitle>@L["CalendarTitle"] · Huishoudboek</PageTitle>
@{ var forecast = CashFlow.Project(State.Data, State.Today, State.Scope, minimumDays: 90); var selected = forecast.Accounts.FirstOrDefault(a => a.Account.Id == accountId) ?? forecast.Accounts.FirstOrDefault(); }

@if (selected == null)
{
    <h1>@L["CalendarTitle"]</h1>
    <section class="card">
        <p>@L["AddCurrentAccountNote"]</p>
    </section>
}
else
{
    <CashCalendar Forecast="selected">
        <AccountPicker>
            @if (forecast.Accounts.Count > 1)
            {
                <label class="calendar-account"><span>@L["Account"]</span><select value="@selected.Account.Id" @onchange="e => accountId = Guid.Parse(e.Value!.ToString()!)">
                    @foreach (var account in forecast.Accounts) { <option value="@account.Account.Id">@account.Account.Name</option> }
                </select></label>
            }
            else { <small>@selected.Account.Name</small> }
        </AccountPicker>
    </CashCalendar>
    <details class="card" id="calendar-settings" open="@ShowSettings">
        <summary>@L["CalendarSettings"]</summary>
        <SpendingForecastCategories />
        <SpendingHabits Analysis="selected.Learning" />
    </details>
}
<p><a href="vooruitblik">@L["FinancialOutlook"] →</a></p>

@code {
    [SupplyParameterFromQuery(Name = "instellingen")] public bool ShowSettings { get; set; }
    private Guid? accountId;
}
