@page "/kalender"
@attribute [Authorize]
@inherits PageBase
<PageTitle>@L["CalendarTitle"] · Huishoudboek</PageTitle>
@{ var forecast = CashFlow.Project(State.Data, State.Today, State.Scope, minimumDays: 90); var selected = forecast.Accounts.FirstOrDefault(a => a.Account.Id == accountId) ?? forecast.Accounts.FirstOrDefault(); }

<div class="page-heading">
    <h1>@L["CalendarTitle"]</h1>
    <a class="button" href="vooruitblik">@L["FinancialOutlook"]</a>
</div>
<section class="card">
    @if (selected == null)
    {
        <p>@L["AddCurrentAccountNote"]</p>
    }
    else
    {
        <label>@L["Account"]<select value="@selected.Account.Id" @onchange="e => accountId = Guid.Parse(e.Value!.ToString()!)">@foreach (var account in forecast.Accounts) { <option value="@account.Account.Id">@account.Account.Name</option> }</select></label>
        <CashCalendar Forecast="selected" />
        <SpendingHabits Analysis="selected.Learning" />
    }
</section>

@code {
    private Guid? accountId;
}
