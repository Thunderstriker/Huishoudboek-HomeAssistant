<section class="card">
    <h2>@L["EnergyMonthlyCosts"]</h2>
    <p class="muted">@L["EnergyCostsNote"]</p>
    @if (!Report.HasReadings) { <p>@L["EnergyNoReadings"]</p> }
    else
    {
        <div class="metrics">
            <div><strong>@L["EnergyConsumption"]</strong><div>@N(Report.Consumption.Kwh) kWh · @Euro(Report.Consumption.Amount)</div>
                <small>@L["EnergyCoverage", Report.Consumption.Intervals, Report.Expected, Report.Consumption.UnpricedIntervals, Report.Consumption.EstimatedIntervals]</small><br />
                <small>@L["EnergyWeightedRate", N(Report.Consumption.WeightedPrice)]</small></div>
            <div><strong>@L["EnergyInjection"]</strong><div>@N(Report.Injection.Kwh) kWh · @Euro(Report.Injection.Amount)</div>
                <small>@(Report.ExpectedInjection == 0 ? L["EnergyInjectionNone"] : L["EnergyCoverage", Report.Injection.Intervals, Report.ExpectedInjection, Report.Injection.UnpricedIntervals, Report.Injection.EstimatedIntervals])</small><br />
                <small>@L["EnergyWeightedRate", N(Report.Injection.WeightedPrice)]</small></div>
            <div><strong>@L["EnergyFeeAllocation"]</strong><div>@Euro(Report.AllocatedFee)</div><small>@L["EnergyFeeCoverage", Report.FeeDays, Report.ApplicableDays]</small></div>
            <div><strong>@L["EnergyPartialSubtotal"]</strong><div>@Euro(Report.PartialSubtotal)</div><small>@L["EnergyOtherChargesMissing"]</small></div>
        </div>
        <details>
            <summary>@L["EnergyDailyDetails"]</summary>
            <div class="table-wrap" style="overflow-x:auto">
                <table>
                    <thead><tr><th>@L["Date"]</th><th>@L["EnergyConsumption"]</th><th>@L["EnergyInjection"]</th><th>@L["EnergyFeeAllocation"]</th><th>@L["EnergyPartialSubtotal"]</th></tr></thead>
                    <tbody>
                        @foreach (var day in Report.Days)
                        {
                            <tr>
                                <th scope="row">@day.Day.ToString("dd-MM", UiCulture.Culture)</th>
                                <td>@N(day.Consumption.Kwh) kWh · @Euro(day.Consumption.Amount)<br /><small>@L["EnergyCoverage", day.Consumption.Intervals, day.Expected, day.Consumption.UnpricedIntervals, day.Consumption.EstimatedIntervals]</small><br /><small>@L["EnergyWeightedRate", N(day.Consumption.WeightedPrice)]</small></td>
                                <td>@N(day.Injection.Kwh) kWh · @Euro(day.Injection.Amount)<br /><small>@(day.InjectionNotApplicable ? L["EnergyInjectionNone"] : L["EnergyCoverage", day.Injection.Intervals, day.Expected, day.Injection.UnpricedIntervals, day.Injection.EstimatedIntervals])</small><br /><small>@L["EnergyWeightedRate", N(day.Injection.WeightedPrice)]</small></td>
                                <td>@Euro(day.AllocatedFee)</td>
                                <td>@Euro(day.PartialSubtotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
    @if (Report.EarlyEndFee is { } earlyFee) { <p class="notice">@L["EnergyEarlyEndFee", Money(earlyFee)]</p> }
</section>

@code {
    [Parameter, EditorRequired] public EnergyCostReport Report { get; set; } = null!;
    private static string N(decimal? n) => n?.ToString("0.######", UiCulture.Culture) ?? "—";
    private static string Euro(decimal? n) => n.HasValue ? Money(n.Value) : "—";
}
