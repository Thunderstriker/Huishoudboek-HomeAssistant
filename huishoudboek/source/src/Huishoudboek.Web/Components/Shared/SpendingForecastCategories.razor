@inherits PageBase
@{ var selected = SpendingForecast.CategoryIds(State.Data); }
<section class="forecast-scope" aria-label="@L["ForecastCategoriesTitle"]">
    <p><strong>@L["ForecastCategoriesTitle"]:</strong> @(selected.Count == 0 ? L["ForecastNoCategories"].Value : string.Join(", ", State.Data.Categories.Where(c => selected.Contains(c.Id)).Select(c => State.CategoryName(c.Id))))</p>
    <p class="muted">@L["ForecastCategoriesScope"]</p>
    @if (Editable)
    {
        <details>
            <summary>@L["ForecastChooseCategories"]</summary>
            <fieldset>
                <legend>@L["ForecastCategoriesLegend"]</legend>
                @foreach (var entry in CategoryHierarchy.Ordered(State.Data).Where(e => SpendingForecast.Eligible(e.Category)))
                {
                    <label class="check"><input type="checkbox" checked="@selected.Contains(entry.Category.Id)" disabled="@State.Busy" @onchange="e => Toggle(entry.Category.Id, e.Value is true)" />@entry.Path</label>
                }
            </fieldset>
            <p class="muted">@L["ForecastCategoriesSaved"]</p>
        </details>
    }
    else
    { <p><a href="kalender?instellingen=true#calendar-settings">@L["ForecastChooseCategories"] →</a></p> }
</section>

@code {
    [Parameter] public bool Editable { get; set; } = true;
    private Task Toggle(Guid categoryId, bool included) => State.RunAsync(() =>
        State.SaveAsync(d => SpendingForecast.SetIncluded(d, categoryId, included)));
}
