@inherits PageBase
@inject UiPreferences Preferences

<section class="dashboard-accounts" aria-labelledby="dashboard-accounts-heading">
    <div class="accounts-heading">
        <div><h2 id="dashboard-accounts-heading">@L["DashboardYourAccounts"]</h2><time class="account-asof" datetime="@State.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@L["DashboardToday"] · @State.Today.ToString("dd MMM", UiCulture.Culture)</time></div>
        @if (Accounts.Count > 0)
        {
            <details class="account-picker">
                <summary aria-label="@L["DashboardChooseAccounts"]" title="@L["DashboardChooseAccounts"]"><DashboardIcon Name="sliders" /><span>@L["DashboardAdjustAccounts"]</span></summary>
                <div class="card account-picker-panel">
                    <fieldset disabled="@(!Preferences.Loaded || saving)">
                        <legend class="sr-only">@L["DashboardChooseAccounts"]</legend>
                        @foreach (var item in Accounts)
                        {
                            var account = item.Account;
                            <label class="check" @key="account.Id"><input type="checkbox" checked="@Selected(account)" @onchange="e => Toggle(account.Id, e.Value is true)" />@account.Name <small>@Kind(account.Kind)</small></label>
                        }
                        <button @onclick="Reset">@L["DashboardDefaultAccounts"]</button>
                    </fieldset>
                    <p class="muted" role="status">@L[Preferences.CanPersist ? "DashboardAccountPreferenceNote" : "DashboardPreferenceSessionOnly"]</p>
                </div>
            </details>
        }
    </div>
    @if (Accounts.Count == 0)
    {
        <div class="account-empty"><p>@L["DashboardNoAccounts"]</p><a class="button" href="rekeningen">@L["Accounts"] <span aria-hidden="true">→</span></a></div>
    }
    else if (!Preferences.Loaded)
    {
        <p role="status">@L["DashboardLoadingAccounts"]</p>
    }
    else if (!Accounts.Any(a => Selected(a.Account)))
    {
        <div class="account-empty"><p>@L["DashboardNoSelectedAccounts"]</p><button @onclick="Reset" disabled="@saving">@L["DashboardDefaultAccounts"]</button></div>
    }
    else
    {
        <div class="account-grid" tabindex="0" role="region" aria-label="@L["DashboardYourAccounts"]">
            @foreach (var item in Accounts.Where(a => Selected(a.Account)))
            {
                var account = item.Account;
                <article class="account-card @(account.Kind == AccountKind.Current ? "current-account" : account.Kind == AccountKind.Investment ? "investment-account" : "savings-account")" data-account-id="@account.Id" @key="account.Id">
                    <span class="account-symbol"><DashboardIcon Name="@(account.Kind == AccountKind.Investment ? "trends" : account.Kind == AccountKind.Savings ? "savings" : "wallet")" /></span>
                    <div class="account-copy"><h3><a href="@UiNavigation.Transactions(account: account.Id, owner: State.OwnerId)">@account.Name</a></h3><span class="account-kind">@Kind(account.Kind)</span></div>
                    <div class="metric-value @(item.Balance.Total < 0 ? "negative" : "")"><small class="recorded-balance-label">@L[account.Kind == AccountKind.Investment ? "DashboardRecordedValue" : "DashboardRecordedBalance"]</small>@Money(item.Balance.Total)</div>
                    <div class="account-freshness">
                        @if (item.StaleImports) { <a class="freshness-status warning" href="@($"importeren?account={account.Id:D}")">@L["CheckImport"] <span aria-hidden="true">↗</span></a> }
                        else { <span class="freshness-status">@L["DashboardRecentImport"]</span> }
                        <span class="import-through">@L["DashboardImportedThrough", item.ImportedThrough?.ToString("dd-MM-yyyy") ?? L["Unknown"].Value]</span>
                    </div>
                    @if (account.Kind == AccountKind.Investment)
                    {
                        <details class="investment-detail"><summary>@L["CashBalance"] / @L["Securities"]</summary><p>@L["CashBalance"]: @Money(item.Balance.Cash)<br />@L["Securities"]: @Money(item.Balance.Securities)<br />@L["Valuation"]: @(item.Balance.ValuationDate?.ToString("dd-MM-yyyy") ?? L["NoValuation"].Value)</p></details>
                    }
                </article>
            }
        </div>
    }
    <div class="accounts-footer"><details class="balance-details"><summary>@L["DashboardAboutBalances"]</summary><p>@L["DashboardBalancesToday", State.Today.ToString("dd-MM-yyyy")]</p></details><a href="rekeningen">@L["Accounts"] <span aria-hidden="true">↗</span></a></div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HomeAccount> Accounts { get; set; } = [];
    private bool saving;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Preferences.Changed += PreferencesChanged;
    }
    private void PreferencesChanged() => _ = InvokeAsync(StateHasChanged);
    private bool Selected(Account account) => Preferences.DashboardAccountIds?.Contains(account.Id) ?? account.Kind == AccountKind.Current;
    private async Task Toggle(Guid id, bool selected)
    {
        var ids = Preferences.DashboardAccountIds?.ToHashSet() ?? State.Data.Accounts.Where(a => a.Kind == AccountKind.Current).Select(a => a.Id).ToHashSet();
        if (selected) ids.Add(id); else ids.Remove(id);
        saving = true;
        try { await Preferences.SetDashboardAccountsAsync(ids); }
        finally { saving = false; }
    }
    private async Task Reset()
    {
        saving = true;
        try { await Preferences.SetDashboardAccountsAsync(null); }
        finally { saving = false; }
    }
    public override void Dispose()
    {
        Preferences.Changed -= PreferencesChanged;
        base.Dispose();
    }
}
