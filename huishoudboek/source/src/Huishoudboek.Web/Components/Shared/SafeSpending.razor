@inherits EditPageBase
@{ var forecast = CashFlow.Project(State.Data, State.Today, State.Scope); var selected = forecast.Accounts.FirstOrDefault(a => a.Account.Id == accountId) ?? forecast.Accounts.FirstOrDefault(); }
<section class="card" id="bestedingsruimte">
    <div class="page-heading"><h2>@L["SafeSpendingTitle"]</h2><a class="button" href="vaste-posten">@L["PlanIncomeBills"]</a></div>
    <p class="muted">@L["SafeSpendingNote", State.Today.ToString("dd-MM-yyyy")]</p>
    @if (selected == null)
    {
        <p>@L["AddCurrentAccountNote"]</p>
    }
    else
    {
        <div class="metrics">
            <div><div class="metric-label">@L["EstimatedSpendable"]</div><div class="metric-value">@Money(forecast.EstimatedSpendable)</div><small>@L["SpendableSumNote"]</small></div>
            <div><div class="metric-label">@L["BillsNextDays", 7]</div><div class="metric-value">@Money(forecast.Bills7Days)</div></div>
            <div><div class="metric-label">@L["BillsNextDays", 30]</div><div class="metric-value">@Money(forecast.Bills30Days)</div><small>@L["BillsEstimateNote"]</small></div>
        </div>
        @if (forecast.Accounts.Any(a => a.BufferAtRisk))
        { <p class="notice warning" role="alert">@L["BufferRiskWarning"]</p> }
        <div class="table-scroll"><table><thead><tr><th>@L["Account"]</th><th class="money">@L["BalanceToday"]</th><th>@L["NextIncome"]</th><th class="money">@L["Buffer"]</th><th class="money">@L["SpendableUntilIncome"]</th><th class="money">@L["LowestExpectedBalance"]</th><th>@L["LowestBalanceDate"]</th></tr></thead><tbody>
        @foreach (var account in forecast.Accounts)
        {
            <tr><td>@account.Account.Name @if (account.StaleImports) { <small class="badge">@L["CheckImport"]</small> }</td><td class="money">@Money(account.CurrentBalance)</td><td>@(account.NextIncomeDate?.ToString("dd-MM-yyyy") ?? L["UnknownThirtyDays"].Value)</td><td class="money">@Money(account.Account.MinimumCashBuffer)</td><td class="money">@Money(account.EstimatedSpendable)</td><td class="money @(account.BufferAtRisk ? "negative" : "")">@Money(account.LowestBalance)</td><td>@account.LowestDate.ToString("dd-MM-yyyy")</td></tr>
        }
        </tbody></table></div>
        <div class="fields">
            <label>@L["PurchaseAccount"]<select value="@selected.Account.Id" @onchange="e => accountId = Guid.Parse(e.Value!.ToString()!)">@foreach (var account in forecast.Accounts) { <option value="@account.Account.Id">@account.Account.Name</option> }</select></label>
            <label>@L["PurchaseAmountQuestion"]<input type="text" inputmode="decimal" @bind="purchase" @bind:event="oninput" /></label>
        </div>
        @if (decimal.TryParse(purchase, NumberStyles.AllowDecimalPoint, UiCulture.Culture, out var amount) && amount > 0 && decimal.Round(amount, 2) == amount)
        {
            var fits = selected.CanAfford(amount);
            var uncertain = selected.HasUncertainty;
            <p class="notice @(!fits || uncertain ? "warning" : "success")" role="status">
                <strong>@L[!fits ? "PurchaseDoesNotFit" : uncertain ? "PurchaseUncertain" : "PurchaseFits", Money(amount), selected.Account.Name]</strong>
                @L["PurchaseBalanceNote", Money(selected.LowestBalance - amount), selected.LowestDate.ToString("dd-MM-yyyy"), Money(selected.Account.MinimumCashBuffer)]
                @L["PurchaseHorizonNote", selected.Days.Last().Date.ToString("dd-MM-yyyy")]
            </p>
        }
        else { <p class="muted">@L["PositiveAmountHint", UiCulture.Culture.NumberFormat.NumberDecimalSeparator]</p> }
        <div class="actions"><button @onclick="() => Draft = EditorDraft.CashBuffer(State, selected.Account)">@L["SetBuffer"] · @selected.Account.Name</button></div>
        <p class="muted">@L["AccountImportNote", selected.Account.Name, selected.StatementThrough?.ToString("dd-MM-yyyy") ?? L["Unknown"].Value, selected.LastImportDate?.ToString("dd-MM-yyyy") ?? L["None"].Value, Money(selected.DailyVariableEstimate)]</p>
        @if (selected.AwaitingBankDataCount > 0)
        { <p class="notice" role="status">@L["RecurringAwaitingSummary", selected.AwaitingBankDataCount] <a href="importeren">@L["ImportExcelCsv"]</a></p> }
        @if (selected.UncertainReserve > 0)
        { <p class="muted">@L["RecurringReserveNote", Money(selected.UncertainReserve)] <a href="vaste-posten">@L["RecurringPayments"]</a></p> }
        @if (selected.Warnings.Count > 0)
        { <details class="notice warning"><summary>@L["AccountAttention", selected.Account.Name] (@selected.Warnings.Count)</summary><ul>@foreach (var warning in UiCashFlow.Warnings(State.Data, selected, State.Today)) { <li>@warning</li> }</ul><a href="vaste-posten">@L["RecurringPayments"]</a></details> }
        <details><summary>@L["UpcomingPayments"] · @selected.Account.Name · @L["Days", 30]</summary>
            <div class="table-scroll"><table><thead><tr><th>@L["ExpectedDate"]</th><th>@L["Payment"]</th><th class="money">@L["Amount"]</th><th>@L["Source"]</th></tr></thead><tbody>
            @foreach (var bill in selected.Events.Where(e => e.Amount < 0 && e.Date <= State.Today.AddDays(30)))
            { <tr><td>@(bill.IsUncertain ? L["PaymentTimingUnknown"].Value : bill.Date.ToString("dd-MM-yyyy"))</td><td>@bill.Name @if (bill.IsUncertain) { <small>@L["RecurringUnconfirmedDate", bill.DueDate.ToString("dd-MM-yyyy")]</small> }</td><td class="money">@Money(-bill.Amount)</td><td>@L[bill.IsUncertain ? "UnconfirmedReserve" : bill.TransactionId != null ? "RecordedEntry" : "RecurringEstimate"]</td></tr> }
            </tbody></table></div>
        </details>
        <details><summary>@L["DailyBalanceForecast"] · @selected.Account.Name · @L["ThroughDate", selected.Days.Last().Date.ToString("dd-MM-yyyy")]</summary>
            <p class="muted">@L["DailyBalanceNote"]</p>
            <div class="table-scroll"><table><thead><tr><th>@L["Date"]</th><th class="money">@L["OpeningBalance"]</th><th class="money">@L["Receipts"]</th><th class="money">@L["PaymentsAndReserves"]</th><th class="money">@L["ExtraDaily"]</th><th class="money">@L["LowestBalance"]</th><th class="money">@L["ClosingBalance"]</th></tr></thead><tbody>
            @foreach (var day in selected.Days)
            { <tr><td>@day.Date.ToString("dd-MM-yyyy")</td><td class="money">@Money(day.OpeningBalance)</td><td class="money">@Money(day.Income)</td><td class="money">@Money(day.Payments)</td><td class="money">@Money(day.VariableSpending)</td><td class="money @(day.LowestBalance < selected.Account.MinimumCashBuffer ? "negative" : "")">@Money(day.LowestBalance)</td><td class="money">@Money(day.ClosingBalance)</td></tr> }
            </tbody></table></div>
        </details>
    }
    <details><summary>@L["EstimateAssumptions"]</summary>
        <ul>
            <li>@L["AssumptionImports", CashFlow.StaleAfterDays]</li>
            <li>@L["AssumptionRecurring"]</li>
            <li>@L["AssumptionOverdue"]</li>
            <li>@L["AssumptionVariable", CashFlow.HistoryDays]</li>
            <li>@L["AssumptionSpendable", CashFlow.IncomeSearchDays]</li>
            <li>@L["AssumptionShared"]</li>
        </ul>
    </details>
</section>
<EditDialogs Page="this" />
@code {
    private Guid? accountId;
    private string purchase = 150m.ToString("F2", UiCulture.Culture);
}
