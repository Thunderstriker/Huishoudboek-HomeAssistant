<section class="card">
    <h3>@L["EnergyImportReview"]</h3>
    <p>@L["EnergyImportSummary", Preview.File.Rows, Preview.File.Readings.Count + Preview.File.Peaks.Count, Preview.Unchanged, Preview.File.DuplicateRows, Preview.Conflicts]</p>
    @foreach (var group in Preview.File.Readings.GroupBy(r => (r.Ean, r.Meter, r.Resolution)))
    {
        <p><strong>EAN @group.Key.Ean · @group.Key.Meter</strong> · @L[$"EnergyReading{group.Key.Resolution}"] · @Day(group.Min(r => r.StartUtc)) – @Day(group.Max(r => r.StartUtc))</p>
        <ul>
            @foreach (var register in group.GroupBy(r => (r.Direction, r.Register)))
            {
                <li>@L[$"Energy{register.Key.Direction}"] · @L[$"EnergyRegister{register.Key.Register}"] · @register.Count() · @N(register.Sum(r => r.Quantity)) kWh</li>
            }
        </ul>
    }
    @foreach (var group in Preview.File.Peaks.GroupBy(p => (p.Ean, p.Meter)))
    {
        <p><strong>EAN @group.Key.Ean · @group.Key.Meter</strong> · @L["EnergyPeakImportRange", group.Count(), Month(group.Min(p => p.Month)), Month(group.Max(p => p.Month))]</p>
        <ul>
            @foreach (var peak in group.OrderByDescending(p => p.Month).Take(12)) { <li>@Month(peak.Month) · @DescribePeak(peak)</li> }
        </ul>
    }
    @if (Preview.File.IssueCount > 0)
    {
        <details>
            <summary>@L["EnergyImportIssues", Preview.File.IssueCount, Preview.File.Issues.Count]</summary>
            <ul>@foreach (var issue in Preview.File.Issues) { <li>@L["EnergyImportRow", issue.Row] @L[$"EnergyCsv{issue.Problem}"]</li> }</ul>
        </details>
        <label class="check"><input type="checkbox" @bind="acknowledge" />@L["EnergySkipIssues"]</label>
    }
    @if (Preview.Conflicts > 0)
    {
        <details>
            <summary>@L["EnergyImportConflicts", Preview.Conflicts]</summary>
            <ul>
                @foreach (var change in Replacements().Skip(page * 20).Take(20))
                {
                    <li><strong>@change.Title</strong>
                        <div>@L["EnergyBefore"]: @change.Before</div>
                        <div>@L["EnergyAfter"]: @change.After</div>
                    </li>
                }
            </ul>
            <div class="actions">
                <button disabled="@(page == 0)" @onclick="() => page--">‹</button>
                <span>@(page + 1) / @((Preview.Conflicts + 19) / 20)</span>
                <button disabled="@((page + 1) * 20 >= Preview.Conflicts)" @onclick="() => page++">›</button>
            </div>
        </details>
        <label class="check"><input type="checkbox" @bind="replace" />@L["EnergyConfirmReplace"]</label>
    }
    <div class="actions">
        <button class="primary" disabled="@(Busy || Preview.ChangeCount == 0 || Preview.Conflicts > 0 && !replace || Preview.File.IssueCount > 0 && !acknowledge)"
                @onclick="() => OnConfirm.InvokeAsync(replace)">@L["EnergyConfirmImport"]</button>
        <button disabled="@Busy" @onclick="OnCancel">@L["Cancel"]</button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public EnergyImportPreview Preview { get; set; } = null!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<bool> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private bool acknowledge, replace;
    private int page;
    private IEnumerable<(string Title, string Before, string After)> Replacements()
    {
        foreach (var change in Preview.Changes.Where(c => c.NeedsReplacement))
        {
            var reading = change.Before[0];
            var period = reading.Resolution == EnergyReadingResolution.DailyTotal ? Day(reading.StartUtc) : Local(reading.StartUtc);
            yield return ($"{reading.Ean} · {L[$"EnergyReading{reading.Resolution}"]} · {period}", Describe(change.Before), Describe(change.After));
        }
        foreach (var change in Preview.PeakChanges)
            if (change.Before is { } peak)
                yield return ($"{peak.Ean} · {L["EnergyMonthlyPeak"]} · {Month(peak.Month)}", DescribePeak(peak), DescribePeak(change.After));
    }
    private static string DescribePeak(EnergyMonthlyPeak peak) => $"{peak.Meter} · {N(peak.Kw)} kW ({peak.Status})";
    private static string Month(DateOnly month) => month.ToString("MMM yyyy", UiCulture.Culture);
    private string Describe(IEnumerable<EnergyReading> readings) => string.Join("; ", readings.Select(r =>
        $"{r.Meter} · {L[$"Energy{r.Direction}"]}/{L[$"EnergyRegister{r.Register}"]}: {N(r.Quantity)} kWh ({r.Status})"));
    private static string N(decimal value) => value.ToString("0.############", UiCulture.Culture);
    private static string Day(DateTime time) => BelgianEnergyTime.Day(time).ToString("dd-MM-yyyy", UiCulture.Culture);
    private static string Local(DateTime time) => TimeZoneInfo.ConvertTime(new DateTimeOffset(time), BelgianEnergyTime.Zone).ToString("dd-MM-yyyy HH:mm zzz", UiCulture.Culture);
}
