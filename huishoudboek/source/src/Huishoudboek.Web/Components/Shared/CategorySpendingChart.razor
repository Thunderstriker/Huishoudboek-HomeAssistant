@{
    var categories = Categories.Where(c => c.Spent > 0 || c.Budget > 0).OrderByDescending(c => c.Spent).ToList();
    var maximum = Math.Max(1m, categories.Select(c => Math.Max(c.Spent, c.Budget)).DefaultIfEmpty().Max());
    var total = categories.Sum(c => c.Spent);
}
@if (categories.Count == 0)
{
    <p class="muted">Nog geen uitgaven of budgetten in deze periode.</p>
}
else
{
    <div class="spending-chart" role="list" aria-label="Uitgaven vergeleken met categoriebudgetten">
        @foreach (var category in categories)
        {
            <div class="spending-row" role="listitem">
                <div class="spending-label"><strong>@category.Name</strong><span>@Money(category.Spent) <small>(@((total > 0 ? category.Spent / total : 0).ToString("P0", CultureInfo.GetCultureInfo("nl-NL"))))</small></span></div>
                <div class="spending-track" aria-hidden="true">
                    <div class="spending-fill @(category.IsOverBudget ? "over-budget" : "")" style="width:@Percent(category.Spent, maximum)%"></div>
                    @if (category.Budget > 0)
                    {
                        <span class="budget-marker" style="left:@Percent(category.Budget, maximum)%"></span>
                    }
                </div>
                <small class="@(category.IsOverBudget ? "negative" : "muted")">@(category.Budget > 0 ? $"Budget {Money(category.Budget)}" : "Geen limiet")@(category.IsOverBudget ? $" · {Money(category.Overspent)} boven budget" : "")</small>
            </div>
        }
    </div>
    <p class="muted chart-note">Balk = uitgegeven; streep = budget. Alle balken gebruiken dezelfde euroschaal. Percentage = aandeel in de uitgaven.</p>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CategoryResult> Categories { get; set; } = [];

    private static string Percent(decimal amount, decimal maximum) => (amount / maximum * 100).ToString("0.##", CultureInfo.InvariantCulture);
}
