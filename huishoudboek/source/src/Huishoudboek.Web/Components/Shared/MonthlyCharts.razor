@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="@(SpendingOnly ? "monthly-charts spending-only" : "monthly-charts")">
    <section class="card chart-card">
        <h2>@L["WhereMoneyGoes"]</h2>
        @if (spending.Count == 0)
        {
            <p class="muted">@L["NoMonthlySpending"]</p>
        }
        <div class="spending-summary" hidden="@(spending.Count == 0)">
            <div class="doughnut-wrap">
                <canvas @ref="spendingCanvas" role="img" aria-label="@L["MonthlySpendingChart"]"></canvas>
                <div class="doughnut-total" aria-hidden="true"><small>@L["Spent"]</small><strong>@Money(total)</strong></div>
            </div>
            <ul class="spending-legend">
                @for (var index = 0; index < spending.Count; index++)
                {
                    var item = spending[index];
                    <li><i style="background:@Color(index)" aria-hidden="true"></i><span>@if (!(hasOther && index == spending.Count - 1)) { <a href="@CategoryBookings(item.Id)">@item.Name</a> } else { @item.Name }</span><strong>@Money(item.Spent)<small>@((item.Spent / total).ToString("P0", UiCulture.Culture))</small></strong></li>
                }
            </ul>
        </div>
        <p class="muted chart-note">@L[SpendingOnly ? "DashboardLargestCategoriesNote" : "LargestCategoriesNote"]</p>
        @if (Report.Categories.Any(c => c.Spent < 0)) { <p class="muted chart-note">@L["RecoveryChartNote"]</p> }
    </section>
    @if (!SpendingOnly)
    {
        <section class="card chart-card">
            <h2>@L["ActualExpected"]</h2>
            @if (!hasCashFlow)
            {
                <p class="muted">@L["NoMonthlyAmounts"]</p>
            }
            <div class="forecast-wrap" hidden="@(!hasCashFlow)">
                <canvas @ref="forecastCanvas" role="img" aria-label="@L["MonthlyForecastChart"]"></canvas>
            </div>
            <p class="muted chart-note">@L["ForecastChartNote"]</p>
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public MonthlyReport Report { get; set; } = null!;
    [Parameter] public bool SpendingOnly { get; set; }
    [Parameter] public int? Year { get; set; }
    [Parameter] public int? Month { get; set; }
    [Parameter] public Guid? OwnerId { get; set; }

    private bool hasOther;
    private string Color(int index) => hasOther && index == spending.Count - 1 ? CategoryColors.Other : CategoryColors.For(spending[index].Id);
    private string CategoryBookings(Guid id) => UiNavigation.Transactions(category: id, owner: OwnerId,
        from: Year is { } y && Month is { } m ? new DateOnly(y, m, 1) : null,
        through: Year is { } year && Month is { } month ? UiNavigation.ActualThrough(new DateOnly(year, month, 1).AddMonths(1).AddDays(-1)) : null);
    private List<CategoryResult> spending = [];
    private decimal total;
    private bool hasCashFlow;
    private ElementReference spendingCanvas;
    private ElementReference forecastCanvas;
    private IJSObjectReference? module;
    private IJSObjectReference? charts;
    private readonly SemaphoreSlim chartLock = new(1, 1);
    private bool disposed;

    protected override void OnParametersSet()
    {
        var categories = Report.Categories.Where(c => c.Spent > 0).OrderByDescending(c => c.Spent).ToList();
        spending = categories.Take(5).Select(c => c.Id == Guid.Empty ? c with { Name = L["Uncategorized"] } : c).ToList();
        hasOther = categories.Count > 5;
        if (categories.Count > 5)
            spending.Add(new(Guid.Empty, L["OtherCategories"], 0, categories.Skip(5).Sum(c => c.Spent)));
        total = categories.Sum(c => c.Spent);
        hasCashFlow = Report.Income != 0 || Report.Outflow != 0 || Report.Available != 0 ||
            Report.Forecast.Income != 0 || Report.Forecast.Outflow != 0 || Report.Forecast.Available != 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await chartLock.WaitAsync();
        try
        {
            if (disposed) return;
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Huishoudboek.Web/financial-charts.js");
            if (disposed) return;
            charts ??= await module.InvokeAsync<IJSObjectReference>("create", spendingCanvas, SpendingOnly ? null : (object)forecastCanvas, new {
                locale = UiCulture.Culture.Name, income = L["Income"].Value, outflow = L["Outflow"].Value,
                available = L["Available"].Value, actual = L["Actual"].Value, forecast = L["Forecast"].Value });
            if (disposed) return;
            await charts.InvokeVoidAsync("update", new {
                labels = spending.Select(c => c.Name),
                spending = spending.Select(c => c.Spent),
                colors = Enumerable.Range(0, spending.Count).Select(Color),
                actual = new[] { Report.Income, Report.Outflow, Report.Available },
                forecast = new[] { Report.Forecast.Income, Report.Forecast.Outflow, Report.Forecast.Available }
            });
        }
        finally { chartLock.Release(); }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await chartLock.WaitAsync();
        try
        {
            if (charts != null)
            {
                await charts.InvokeVoidAsync("destroy");
                await charts.DisposeAsync();
            }
            if (module != null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { chartLock.Release(); }
    }
}
