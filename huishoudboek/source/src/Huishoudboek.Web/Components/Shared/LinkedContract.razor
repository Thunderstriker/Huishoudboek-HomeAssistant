@inject WebState State
@if (SubscriptionContracts.Visible(State.Data, State.OwnerId).FirstOrDefault(c => c.RecurringPaymentId == RecurringPaymentId) is { } contract)
{
    <a class="linked-contract" href="@($"abonnementen?contract={contract.Id}#contract-{contract.Id}")">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6m-6 4h6" /></svg>
        @L["LinkedContract", contract.Name]
    </a>
}
@code {
    [Parameter, EditorRequired] public Guid RecurringPaymentId { get; set; }
}
