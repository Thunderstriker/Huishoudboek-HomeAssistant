@inject WebState State
@inject IJSRuntime JS
@if (HasChanges) { <NavigationLock ConfirmExternalNavigation="true" OnBeforeInternalNavigation="BeforeNavigate" /> }
<Modal Title="@Current.Title" Cancel="Cancel">
    <p class="muted">@Current.Note</p>
    @if (Current.Error.Length > 0) { <p class="notice error" role="alert">@Current.Error</p> }
    @if (proposal is { ReviewRecognition: true } batch)
    {
        <p class="notice" role="status">@L["RecognitionPreviewCount", batch.PreviewCount, batch.MatchCount]</p>
        <p class="muted">@L["RecognitionHistoryHelp"]</p>
        @if (batch.AmbiguousNameCount > 0) { <p class="notice warning">@L["RecognitionAmbiguousWarning", batch.AmbiguousNameCount]</p> }
        @if (batch.EarlierCategoryCount > 0) { <p class="notice warning">@L["RecognitionCategoryOrderWarning", batch.EarlierCategoryCount]</p> }
        <details><summary>@L["MatchingExamples"]</summary>@foreach (var sample in batch.Samples) { <p class="description">@sample.Date.ToString("dd-MM-yyyy") · @sample.Description · @WebState.Money(sample.Amount)</p> }</details>
        <div class="actions"><button type="button" @onclick="() => selected = batch.Changes.Select(c => c.Before.Id).ToHashSet()">@L["SelectAllRecognition"]</button><button type="button" @onclick="() => selected.Clear()">@L["ClearSelection"]</button></div>
        <div class="table-scroll"><table><thead><tr><th>@L["Select"]</th><th>@L["BankEntry"]</th><th>@L["RecognizeAsName"]</th><th>@L["Category"]</th><th>@L["PlanningLink"]</th></tr></thead><tbody>
        @foreach (var change in batch.Changes.Skip(page * 50).Take(50))
        {
            <tr @key="change.Before.Id"><td><input type="checkbox" aria-label="@L["SelectPayment"]" checked="@selected.Contains(change.Before.Id)" @onchange="e => Select(change.Before.Id, (bool)e.Value!)" /></td>
                <td class="description">@change.Before.Date.ToString("dd-MM-yyyy") · @State.AccountName(change.Before.AccountId) · @WebState.Money(change.Before.Amount)<small>@change.Before.Description</small></td>
                <td>@change.After.RecognizedName @if (change.Before.RecognizedName != change.After.RecognizedName && change.Before.RecognizedName.Length > 0) { <small>@L["Previously"]: @change.Before.RecognizedName</small> } @if (change.Before.UserDescription.Length > 0) { <small>@L["OwnDescriptionPreserved"]</small> }</td>
                <td>@State.CategoryName(change.After.CategoryId) @if (change.Before.CategoryId != change.After.CategoryId) { <small>@L["Previously"]: @State.CategoryName(change.Before.CategoryId)</small> }</td>
                <td>@if (change.After.RecurringPaymentId != change.Before.RecurringPaymentId) { <span class="badge">@L["ScheduledPaymentLinked"]</span><small>@change.PlanningName · @change.After.RecurringOccurrenceDate?.ToString("dd-MM-yyyy")</small> } else { <span>—</span> }</td>
            </tr>
        }
        </tbody></table></div>
        <Pager Count="batch.Changes.Count" Size="50" @bind-Page="page" />
        <fieldset class="page-fieldset" disabled="@State.Busy"><div class="actions">
            <button type="button" @onclick="() => proposal = null">@L["Back"]</button>
            <button type="button" @onclick="() => Commit(false)">@L["SaveSettingsOnly"]</button>
            <button type="button" class="primary" disabled="@(selected.Count == 0)" @onclick="() => Commit(true)">@L["SaveAndRecognizeRows", selected.Count]</button>
        </div></fieldset>
    }
    else
    {
    <form @ref="form" @onsubmit="Save" @onsubmit:preventDefault novalidate>
        <fieldset class="page-fieldset" disabled="@State.Busy">
            @if (Current.IsRecognition)
            {
                @if (State.Data.Transactions.FirstOrDefault(t => t.Id == Current.SeedTransactionId) is { } source)
                { <p class="description"><strong>@L["OriginalDescription"]</strong><br />@source.Description</p> }
                <label>@L["UseExistingRecognition"]<select value="@(State.Data.Rules.Any(r => r.Id == Current.RecognitionRuleId) ? Current.RecognitionRuleId?.ToString() : "")" @onchange="ChooseRule"><option value="">@L["NewRecognition"]</option>
                @foreach (var rule in State.Data.Rules.Where(r => r.AccountId == null || State.Scope.Contains(r.AccountId.Value)))
                { <option value="@rule.Id">@(TransactionRecognition.RuleName(State.Data, rule) is { Length: > 0 } name ? name : rule.Contains) · @State.CategoryName(rule.CategoryId)</option> }
                </select></label>
                <p class="muted">@L["ExistingRecognitionHelp"]</p>
            }
            <div class="fields">
                @foreach (var field in Current.Fields.Where(Current.IsFieldVisible))
                {
                    @if (field.Type == "owners")
                    {
                        <div class="field-note"><strong>@field.Label</strong><div class="owner-choices" role="group" tabindex="-1" aria-invalid="@(field.Error.Length > 0 ? "true" : "false")" aria-describedby="@(field.Error.Length > 0 ? field.Key + "-error" : null)">
                            @foreach (var option in field.Options)
                            { var id = Guid.Parse(option.Value); <label class="check"><input type="checkbox" checked="@field.OwnerIds.Contains(id)" @onchange="e => ToggleOwner(field, id, e)" />@option.Label</label> }
                        </div>@if (field.Error.Length > 0) { <small id="@(field.Key + "-error")" class="field-error">@field.Error</small> }</div>
                    }
                    else if (field.Type == "checkbox")
                    { <div><label class="check"><input id="@field.Key" type="checkbox" checked="@bool.Parse(field.Value)" @onchange="e => { field.Value = ((bool)e.Value!).ToString(); FieldChanged(field); }" aria-invalid="@(field.Error.Length > 0 ? "true" : "false")" aria-describedby="@(field.Error.Length > 0 ? field.Key + "-error" : null)" />@field.Label</label>@if (field.Error.Length > 0) { <small id="@(field.Key + "-error")" class="field-error">@field.Error</small> }</div> }
                    else
                    {
                        <label>@Current.Label(field)
                            @if (field.Type == "select")
                            { <select id="@field.Key" @bind="field.Value" @bind:after="() => FieldChanged(field)" disabled="@field.ReadOnly" aria-invalid="@(field.Error.Length > 0 ? "true" : "false")" aria-describedby="@(field.Error.Length > 0 ? field.Key + "-error" : null)">@foreach (var option in Current.Options(field)) { <option value="@option.Value">@option.Label</option> }</select> }
                            else
                            { <input id="@field.Key" type="@(field.Type == "money" ? "text" : field.Type)" inputmode="@(field.Type == "money" ? "decimal" : null)" value="@field.Value" @oninput="e => { field.Value = e.Value?.ToString() ?? string.Empty; FieldChanged(field); }" required="@field.Required" disabled="@field.ReadOnly" maxlength="2000" aria-invalid="@(field.Error.Length > 0 ? "true" : "false")" aria-describedby="@(field.Error.Length > 0 ? field.Key + "-error" : null)" /> }
                            @if (field.Error.Length > 0) { <small id="@(field.Key + "-error")" class="field-error">@field.Error</small> }
                        </label>
                    }
                }
            </div>
            <div class="actions"><button type="button" @onclick="Cancel">@L["Cancel"]</button><button type="submit" class="primary">@(Current.IsRecognition ? L["PreviewRecognition"].Value : Current.SaveLabel)</button></div>
        </fieldset>
    </form>
    }
</Modal>
@code {
    [Parameter, EditorRequired] public EditorDraft Draft { get; set; } = null!;
    [Parameter] public EventCallback Closed { get; set; }
    private EditorSaveProposal? proposal;
    private EditorDraft? active;
    private EditorDraft Current => active ?? Draft;
    private int page;
    private HashSet<Guid> selected = [];
    private ElementReference form;
    private string baseline = "";
    private bool allowNavigation, focusInvalid;
    private bool HasChanges => !allowNavigation && (Current.Fingerprint != baseline || proposal != null);
    protected override void OnInitialized() => baseline = Draft.Fingerprint;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    { if (focusInvalid) { focusInvalid = false; await JS.InvokeVoidAsync("huishoudboek.focusInvalid", form); } }
    private void FieldChanged(EditorField field) { field.Error = ""; Current.Error = ""; }
    private async Task BeforeNavigate(LocationChangingContext context)
    {
        if (State.Busy || HasChanges && !await JS.InvokeAsync<bool>("confirm", L["DraftDiscardWarning"].Value)) context.PreventNavigation();
        else allowNavigation = true;
    }
    private void Select(Guid id, bool value) { if (value) selected.Add(id); else selected.Remove(id); }
    private async Task Cancel()
    {
        if (State.Busy || HasChanges && !await JS.InvokeAsync<bool>("confirm", L["DraftDiscardWarning"].Value)) return;
        allowNavigation = true; await Closed.InvokeAsync();
    }
    private static void ToggleOwner(EditorField field, Guid id, ChangeEventArgs args) { if ((bool)args.Value!) field.OwnerIds.Add(id); else field.OwnerIds.Remove(id); }
    private void ChooseRule(ChangeEventArgs args)
    {
        var id = Guid.TryParse(args.Value?.ToString(), out var parsed) ? parsed : (Guid?)null;
        active = EditorDraft.Rule(State, State.Data.Rules.FirstOrDefault(r => r.Id == id), State.Data.Transactions.FirstOrDefault(t => t.Id == Draft.SeedTransactionId));
        proposal = null; selected.Clear(); page = 0;
    }
    private async Task Save()
    {
        if (!Current.ValidateFields()) { Current.Error = L["FixHighlightedFields"]; focusInvalid = true; return; }
        if (!await State.RunAsync(() =>
            { proposal = Current.PrepareSave(State.Data, State.Today); selected = proposal.InitialSelection.ToHashSet(); page = 0; return Task.CompletedTask; }))
        { Current.Error = State.Message; return; }
        Current.Error = "";
        if (proposal is { ReviewRecognition: false }) await Commit(false);
    }
    private async Task Commit(bool link)
    {
        if (proposal is not { } operation) return;
        Action<HouseholdData> apply = link && operation.SaveSelected is { } save ? d => save(d, selected) : link ? operation.SaveAndLink : operation.SaveOnly;
        if (await State.RunAsync(() => State.SaveAsync(apply, Current.Revision),
            link ? L["RecognitionRowsApplied", selected.Count] : Current.SuccessMessage)) { allowNavigation = true; await Closed.InvokeAsync(); }
        else Current.Error = State.Message;
    }
}
