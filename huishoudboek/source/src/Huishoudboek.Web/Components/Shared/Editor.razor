@inject WebState State
<Modal Title="@Draft.Title" Cancel="Cancel">
    <p class="muted">@Draft.Note</p>
    @if (Draft.Error.Length > 0) { <p class="notice error" role="alert">@Draft.Error</p> }
    @if (proposal is { MatchCount: > 0 } batch)
    {
        <p class="notice" role="status">@L["RecurringBatchQuestion", batch.MatchCount]</p>
        <p class="muted">@L["RecurringBatchNote"]</p>
        @if (batch.Matches.FirstOrDefault() is { } first)
        { <p><strong>@first.Payment.Name</strong> · @State.AccountName(first.Payment.AccountId) · @L["Planned"] @WebState.Money(first.Payment.Amount)</p> }
        <div class="table-scroll"><table><thead><tr><th>@L["Save"]</th><th>@L["PlannedPaymentDate"]</th><th>@L["BankEntry"]</th><th class="money">@L["Actual"]</th></tr></thead><tbody>
        @foreach (var match in batch.Matches)
        { <tr @key="match.Transaction.Id"><td><input type="checkbox" aria-label="@L["SelectRecurringMatch"]" checked="@selected.Contains(match.Transaction.Id)" @onchange="e => Select(match.Transaction.Id, (bool)e.Value!)" /></td><td>@match.DueDate.ToString("dd-MM-yyyy")</td><td>@match.Transaction.Date.ToString("dd-MM-yyyy") · @match.Transaction.Description</td><td class="money">@WebState.Money(match.Transaction.Amount)</td></tr> }
        </tbody></table></div>
        <fieldset class="page-fieldset" disabled="@State.Busy"><div class="actions">
            <button type="button" @onclick="() => proposal = null">@L["Back"]</button>
            <button type="button" @onclick="() => Commit(false)">@L["SaveWithoutLinking"]</button>
            <button type="button" class="primary" disabled="@(selected.Count == 0)" @onclick="() => Commit(true)">@L["SaveAndLinkRows", selected.Count]</button>
        </div></fieldset>
    }
    else
    {
    <form @onsubmit="Save" @onsubmit:preventDefault>
        <fieldset class="page-fieldset" disabled="@State.Busy">
            <div class="fields">
                @foreach (var field in Draft.Fields.Where(Draft.IsFieldVisible))
                {
                    @if (field.Type == "owners")
                    {
                        <div class="field-note"><strong>@field.Label</strong><div class="owner-choices">
                            @foreach (var option in field.Options)
                            { var id = Guid.Parse(option.Value); <label class="check"><input type="checkbox" checked="@field.OwnerIds.Contains(id)" @onchange="e => ToggleOwner(field, id, e)" />@option.Label</label> }
                        </div></div>
                    }
                    else if (field.Type == "checkbox")
                    { <label class="check"><input id="@field.Key" type="checkbox" checked="@bool.Parse(field.Value)" @onchange="e => field.Value = ((bool)e.Value!).ToString()" />@field.Label</label> }
                    else
                    {
                        <label>@Draft.Label(field)
                            @if (field.Type == "select")
                            { <select id="@field.Key" @bind="field.Value" disabled="@field.ReadOnly">@foreach (var option in Draft.Options(field)) { <option value="@option.Value">@option.Label</option> }</select> }
                            else
                            { <input id="@field.Key" type="@(field.Type == "money" ? "text" : field.Type)" inputmode="@(field.Type == "money" ? "decimal" : null)" value="@field.Value" @onchange="e => field.Value = e.Value?.ToString() ?? string.Empty" required="@field.Required" disabled="@field.ReadOnly" maxlength="2000" /> }
                        </label>
                    }
                }
            </div>
            <div class="actions"><button type="button" @onclick="Cancel">@L["Cancel"]</button><button type="submit" class="primary">@Draft.SaveLabel</button></div>
        </fieldset>
    </form>
    }
</Modal>
@code {
    [Parameter, EditorRequired] public EditorDraft Draft { get; set; } = null!;
    [Parameter] public EventCallback Closed { get; set; }
    private EditorSaveProposal? proposal;
    private HashSet<Guid> selected = [];
    private void Select(Guid id, bool value) { if (value) selected.Add(id); else selected.Remove(id); }
    private Task Cancel() => State.Busy ? Task.CompletedTask : Closed.InvokeAsync();
    private static void ToggleOwner(EditorField field, Guid id, ChangeEventArgs args) { if ((bool)args.Value!) field.OwnerIds.Add(id); else field.OwnerIds.Remove(id); }
    private async Task Save()
    {
        if (!await State.RunAsync(() =>
            { proposal = Draft.PrepareSave(State.Data, State.Today); selected = proposal.Matches.Select(m => m.Transaction.Id).ToHashSet(); return Task.CompletedTask; }))
        { Draft.Error = State.Message; return; }
        Draft.Error = "";
        if (proposal is { MatchCount: 0 }) await Commit(false);
    }
    private async Task Commit(bool link)
    {
        if (proposal is not { } operation) return;
        Action<HouseholdData> apply = link && operation.SaveSelected is { } save ? d => save(d, selected) : link ? operation.SaveAndLink : operation.SaveOnly;
        if (await State.RunAsync(() => State.SaveAsync(apply, Draft.Revision),
            link ? L["RecurringRowsLinked", selected.Count] : Draft.SuccessMessage)) await Closed.InvokeAsync();
        else Draft.Error = State.Message;
    }
}
