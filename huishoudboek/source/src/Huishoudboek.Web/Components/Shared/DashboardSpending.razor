@inherits PageBase

<section class="dashboard-spending" aria-labelledby="dashboard-spending-heading">
    <div class="spending-heading"><div class="spending-title"><span class="spending-icon"><DashboardIcon Name="budget" /></span><h2 id="dashboard-spending-heading">@L["WhereMoneyGoes"]</h2></div><a href="categorietrends">@L["DashboardViewTrends"] <span aria-hidden="true">↗</span></a></div>
    @if (categories.Count == 0)
    {
        <div class="spending-empty"><DashboardIcon Name="trends" /><h3>@L["DashboardSpendingEmptyTitle"]</h3><p>@L["NoMonthlySpending"]</p><a class="button" href="importeren">@L["ImportExcelCsv"]</a></div>
    }
    else
    {
        <div class="spending-visual">
            <div class="spending-chart">
                <div class="spending-ring" aria-hidden="true" style="--spending-stops:@gradient"></div>
                <div class="spending-total"><strong>@Money(total)</strong><span>@L["DashboardPositiveSpending"]</span></div>
            </div>
            <ul class="category-bars">
                @for (var index = 0; index < categories.Count; index++)
                {
                    var item = categories[index];
                    var share = item.Spent / total;
                    <li style="--category-color:@Colors[index]" data-category-id="@item.Id">
                        <div class="category-heading">
                            @if (item.Id != Guid.Empty) { <a href="categorietrends?categorie=@item.Id">@State.CategoryName(item.Id)</a> }
                            else { <span>@item.Name</span> }
                            <strong>@Money(item.Spent)</strong><small>@share.ToString("P0", UiCulture.Culture)</small>
                        </div>
                        <div class="category-track" aria-hidden="true"><span style="width:@((share * 100).ToString("0.##", CultureInfo.InvariantCulture))%"></span></div>
                    </li>
                }
            </ul>
        </div>
    }
    @if (Report.Categories.Any(c => c.Spent < 0)) { <p class="recovery-note">@L["DashboardSpendingRecoveryNote"] <a href="maand">@L["MonthlyOverview"] →</a></p> }
    <details class="spending-details"><summary>@L["DashboardSpendingDetails"]</summary><p>@L["DashboardCategoryBarsNote"]</p></details>
</section>

@code {
    [Parameter, EditorRequired] public MonthlyReport Report { get; set; } = null!;
    private static readonly string[] Colors = ["#32836b", "#8baada", "#dfad69", "#b3a0cf", "#a4b9ad"];
    private IReadOnlyList<CategoryResult> categories = [];
    private decimal total;
    private string gradient = "";

    protected override void OnParametersSet()
    {
        var spending = Report.Categories.Where(c => c.Spent > 0).OrderByDescending(c => c.Spent).ThenBy(c => c.Name).ToArray();
        var largest = spending.Take(4).Select(c => c.Id == Guid.Empty ? c with { Name = L["Uncategorized"] } : c).ToList();
        if (spending.Length > 4)
            largest.Add(new(Guid.Empty, L["OtherCategories"], 0, spending.Skip(4).Sum(c => c.Spent)));
        categories = largest;
        total = spending.Sum(c => c.Spent);
        var offset = 0m;
        gradient = string.Join(", ", categories.Select((item, index) => {
            var start = offset;
            offset += item.Spent / total * 100;
            return $"{Colors[index]} {start.ToString("0.######", CultureInfo.InvariantCulture)}% {offset.ToString("0.######", CultureInfo.InvariantCulture)}%";
        }));
    }
}
